# Generated by the Vyb JIT/compiler
*.vyb.ll
*.o
*.a

# Realised store is a build cache (regenerated), not source.
store/

# Generation ledger is runtime state (regenerated), not source.
generations/

# Staged rootfs output (regenerated by build-rootfs.vyb), not source.
build/rootfs-out/

# Fetched QEMU kernel cache (downloaded by tools/vybos-run --runtime qemu), not source.
build/kernel-cache/
