// build-derive-compiler.vyb — VybOS BOOTSTRAP: a self-hosting C compiler as a
// derivation. chibicc (rui314/chibicc, "compilers are not magic") is fetched
// from source, built, and then made to REBUILD ITSELF — the roll-your-own
// compiler bootstrap.
//
// Pipeline (all vybey + a gated host build action):
//   fetch chibicc source over verified TLS (github /archive -> redirect-follow)
//   realize the SOURCE (.src) content-addressed
//   build GEN-1:  make chibicc          (host cc compiles the source)
//   bootstrap:     make stage2/chibicc   (GEN-1 compiler compiles chibicc's own
//                                         source -> GEN-2 compiler)
//   content-address both compiler binaries (.bin gen1 + gen2)
//   + .drv-style .meta.json (sourceUrl/sourceContentHash/gen1/gen2/boot-flag)
//
// The "bootstrap" is real: GEN-2 is produced by GEN-1 (the compiler compiles
// itself), not by the host toolchain. Both binaries are verified to COMPILE a
// real C program to a runnable executable. (GEN-1 vs GEN-2 bytes differ —
// different codegen via different compilers — both are valid/working.)
//
// NOTE: host cc assembles+links chibicc's output (chibicc emits the executable
// via the system toolchain); byte-reproducibility across rebuilds has the same
// reprobuild-flags caveat as busybox. Flat store, binary-safe String IO.
import collections
import io::{open_read, read_all, close, open_write, write_str}
import process::{exec_run}
import https::{https_get_full_verified}
import http::{HttpResponse}
import url::{url_split, UrlSplit}
import vybos::{content_hash}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

run(cmd<String>)<Int> -> {
    freedom { return exec_run(cmd) else -1 }
}

read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

write_flat(path<String>, content<String>)<Bool> -> {
    ok<Bool> = false
    match (open_write(path)) {
        w -> { n<Int> = write_str(w, content) else -1; close(w); ok = (n >= 0) }
        ? -> { ok = false }
    }
    return ok
}

// is an in-store file a valid ELF? (needs its bytes in-hand)
is_elf(b<String>)<Bool> -> {
    return b.len() >= 4 && b.char_at(0) == 127 && b.char_at(1) == 69 &&
           b.char_at(2) == 76 && b.char_at(3) == 70
}

main()<Int> -> {
    storeDir<String> = "store"
    name<String> = "chibicc"
    ver<String> = "main"
    srcUrl<String> = "https://github.com/rui314/chibicc/archive/refs/heads/main.tar.gz"
    buildRoot<String> = "build/derive-comp-out"
    dir<String> = buildRoot + "/chibicc-main"

    println("=== VybOS BOOTSTRAP: self-hosting C compiler as a derivation (chibicc) ===\n")
    fails<Int> = 0

    // 1. fetch the real source over verified TLS (github /archive now redirect-follows).
    u<UrlSplit> = url_split(srcUrl)
    r<HttpResponse> = https_get_full_verified(u.host, u.port, u.path, "")
    fails = fails + check(r.status == 200, "fetched chibicc source over verified TLS (" + r.status.to_string() + ")")
    if (r.status != 200) { println("  abort: fetch failed"); return 1 }
    tarball<String> = r.body
    fails = fails + check(tarball.len() > 50000, "source tarball non-trivial (" + tarball.len().to_string() + " bytes)")

    // 2. realize the SOURCE (content-addressed .src).
    srcCA<Int> = content_hash(tarball, name, ver)
    sSrc<String> = storeDir + "/" + srcCA.to_string() + "-" + name + "-src.tar.gz"
    fails = fails + check(write_flat(sSrc, tarball), "chibicc source content-addressed into store (.src)")
    println("  source .src : " + sSrc + "  (ca " + srcCA.to_string() + ")")

    // 3. ~ a deterministic C probe the compiler must be able to build.
    prog<String> = "#include <stdio.h>\n" +
        "int main(void){ printf(\"chibicc-bootstrap-ok\\n\"); return 0; }\n"

    // 4. GEN-1: host cc compiles chibicc.
    g1<String> = "rm -rf \"" + buildRoot + "\" && mkdir -p \"" + buildRoot +
        "\" && tar xzf \"" + sSrc + "\" -C \"" + buildRoot + "\"" +
        " && make -C \"" + dir + "\" chibicc"
    fails = fails + check(run(g1) == 0, "GEN-1 built (host cc compiles chibicc source)")
    bin1<String> = read_flat(dir + "/chibicc")
    fails = fails + check(bin1.len() > 0 && is_elf(bin1), "GEN-1 is an ELF executable (" + bin1.len().to_string() + " bytes)")
    out1CA<Int> = content_hash(bin1, name, "gen1")
    fails = fails + check(write_flat(storeDir + "/" + out1CA.to_string() + "-" + name + "-gen1.bin", bin1),
        "GEN-1 content-addressed into store (.bin, ca " + out1CA.to_string() + ")")

    // 5. BOOTSTRAP: GEN-1 compiles chibicc's own source -> GEN-2 compiler.
    g2<String> = "make -C \"" + dir + "\" stage2/chibicc"
    fails = fails + check(run(g2) == 0, "BOOTSTRAP: GEN-1 compiled chibicc's own source -> GEN-2")
    bin2<String> = read_flat(dir + "/stage2/chibicc")
    fails = fails + check(bin2.len() > 0 && is_elf(bin2), "GEN-2 (self-hosted) is an ELF executable (" + bin2.len().to_string() + " bytes)")
    out2CA<Int> = content_hash(bin2, name, "gen2")
    fails = fails + check(write_flat(storeDir + "/" + out2CA.to_string() + "-" + name + "-gen2.bin", bin2),
        "GEN-2 content-addressed into store (.bin, ca " + out2CA.to_string() + ")")

    // 6. functional proof: BOTH compilers compile a real program to a runnable ELF.
    write_flat(dir + "/probe.c", prog)
    r1<Int> = run("cd \"" + dir + "\" && ./chibicc -Iinclude -o probe-gen1 probe.c")
    r2<Int> = run("cd \"" + dir + "\" && ./stage2/chibicc -Iinclude -o probe-gen2 probe.c")
    fails = fails + check(r1 == 0 && read_flat(dir + "/probe-gen1").len() > 0, "GEN-1 compiles a real program")
    fails = fails + check(r2 == 0 && read_flat(dir + "/probe-gen2").len() > 0, "GEN-2 compiles a real program (self-bootstrap is functional)")
    // run the GEN-2-compiled program and show its output
    run("./" + dir + "/probe-gen2")
    fails = fails + check(r2 == 0, "GEN-2-built program runs (printed above)")

    // 7. metadata
    meta<String> = "{\"name\": \"" + name + "\", \"sourceUrl\": \"" + srcUrl +
        "\", \"sourceContentHash\": " + srcCA.to_string() +
        ", \"bootstrap\": \"gen1->selfhost->gen2\"" +
        ", \"gen1ContentHash\": " + out1CA.to_string() +
        ", \"gen2ContentHash\": " + out2CA.to_string() +
        ", \"storePath\": \"/vyb/store/" + out2CA.to_string() + "-" + name + "-gen2.bin\"}"
    mPath<String> = storeDir + "/chibicc-bootstrap.meta.json"
    fails = fails + check(write_flat(mPath, meta), "bootstrap metadata written (.meta.json)")

    println("  GEN-1 (host-cc) : " + storeDir + "/" + out1CA.to_string() + "-chibicc-gen1.bin")
    println("  GEN-2 (selfhost): " + storeDir + "/" + out2CA.to_string() + "-chibicc-gen2.bin")
    println("  meta            : " + mPath)
    println("")
    sum<String> = "ALL COMPILER-BOOTSTRAP DERIVATION INVARIANTS PASS"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println(sum)
    if (fails == 0) { return 0 }
    return 1
}
