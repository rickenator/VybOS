// build-derive-kernel.vyb — VybOS TOOLCHAIN T3: the Linux kernel as a
// build-stage derivation, compiled by the DERIVED C toolchain. The FLAGSHIP: a
// content-addressed bzImage built from source with a compiler that is ITSELF
// derived (gmp/mpfr/mpc/binutils/gcc), replacing the fetched Alpine netboot
// vmlinuz stop-gap, and giving issue #4's build.plan a real linux-<ver>-vyb
// package.
//
// Pipeline (all vybey + gated host build actions):
//   fetch linux-6.6 source over verified TLS (.tar.xz, 140MB) -> realize .src
//   build host build-tools in-scratch (flex+bison for kconfig parsers,
//     elfutils/libelf for objtool — see notes) into $P
//   build the DERIVED toolchain in-scratch into $TC (gmp->mpfr->mpc->binutils
//     ->gcc 13.2.0 C-only), then compile the kernel with CC=.../gcc
//   kernel OUT-OF-TREE (O=<kbuild>): defconfig + dep-trims + olddefconfig
//     + bzImage
//   content-address arch/x86/boot/bzImage (.bin) + .meta.json
//
// Why these build deps must be COMPILED, not skipped:
//   - x86_64 kernel -> objtool is unconditional (CONFIG_OBJTOOL arch-selected)
//     and links -lelf => need elfutils' libelf (headers+lib); no config trick.
//   - kconfig regenerates scripts/kconfig/{lexer.lex.c,parser.tab.c} from
//     {lexer.l,parser.y} at defconfig time; 6.6 ships no generated parsers =>
//     need flex + bison on PATH.
//   - no pahole => drop DEBUG_INFO/BTF; no openssl => drop MODULE_SIG; use the
//     frame-pointer unwinder (no objtool tables) via UNWINDER_FRAME_POINTER.
//   - flex's git archive omits configure+scan.c => use its RELEASE tarball,
//     fetched by host curl -L (the GitHub asset redirect is cross-host).
//
// Path hygiene: absolute $B scratch base captured BEFORE any cd (relative
// buildRoot paths after cd'ing into subdirs break curl -o and O=). Flat store,
// binary-safe IO, inclusive ranges.
import collections
import io::{open_read, read_all, close, open_write, write_str}
import fs::{mkdir}
import process::{exec_run}
import https::{https_get_full_verified}
import http::{HttpResponse}
import url::{url_split, UrlSplit}
import vybos::{content_hash}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

run(cmd<String>)<Int> -> {
    freedom { return exec_run(cmd) else -1 }
}

read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

write_flat(path<String>, content<String>)<Bool> -> {
    ok<Bool> = false
    match (open_write(path)) {
        w -> { n<Int> = write_str(w, content) else -1; close(w); ok = (n >= 0) }
        ? -> { ok = false }
    }
    return ok
}

// The Linux boot protocol puts the magic "HdrS" (setup header signature) at
// byte offset 0x202 of arch/x86/boot/bzImage. A real bzImage has it.
has_hdrs(b<String>)<Bool> -> {
    o<Int> = 514   // 0x202 — offset of the 'HdrS' setup-header signature
    if (b.len() < o + 4) { return false }
    return b.char_at(o) == 72 && b.char_at(o+1) == 100 &&
           b.char_at(o+2) == 114 && b.char_at(o+3) == 83
}

// kconfig configure + dep-trim command for a GIVEN build dir (absolute $B/...).
// Each kernel build gets its OWN independent build root (kbA/kbB) so the
// byte-determinism proof also proves PATH-INDEPENDENCE, not just a clean
// rebuild in the same dir. `dir` is an absolute shell path exprs like "$B/kbA".
kcfgOp(dir<String>, ver<String>)<String> -> {
    nl<String> = "linux-" + ver
    return "cd \"$B/" + nl + "\" && make O=\"" + dir + "\" defconfig" +
        " && \"$B/" + nl + "/scripts/config\" --file \"" + dir + "/.config\"" +
        " -d DEBUG_INFO -d DEBUG_INFO_BTF -d GDB_SCRIPTS -d STACK_VALIDATION" +
        " -d UNWINDER_ORC -e UNWINDER_FRAME_POINTER" +
        " -d OBJTOOL -d MODULE_SIG -d SYSTEM_TRUSTED_KEYS -d SYSTEM_REVOCATION_KEYS" +
        " && make O=\"" + dir + "\" olddefconfig" +
        " && \"$B/" + nl + "/scripts/config\" --file \"" + dir + "/.config\"" +
        " -d OBJTOOL -d STACK_VALIDATION -d UNWINDER_ORC -e UNWINDER_FRAME_POINTER" +
        " && make O=\"" + dir + "\" olddefconfig"
}

main()<Int> -> {
    storeDir<String> = "store"
    buildRoot<String> = "build/derive-kernel-out"
    name<String> = "linux"
    ver<String> = "6.6"
    srcUrl<String> = "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-" + ver + ".tar.xz"

    println("=== VybOS TOOLCHAIN T3: Linux kernel bzImage built with the DERIVED gcc ===\n")
    fails<Int> = 0

    // 1. fetch + realize the kernel source (140MB — verified the client survives it).
    u<UrlSplit> = url_split(srcUrl)
    r<HttpResponse> = https_get_full_verified(u.host, u.port, u.path, "")
    fails = fails + check(r.status == 200, "fetched kernel source over verified TLS (" + r.status.to_string() + ")")
    if (r.status != 200) { println("  abort: fetch failed"); return 1 }
    srcCA<String> = content_hash(r.body, name, ver)
    sSrc<String> = storeDir + "/" + srcCA + "-" + name + "-" + ver + "-src.tar.xz"
    fails = fails + check(r.body.len() > 100000000, "kernel source tarball non-trivial (" + r.body.len().to_string() + " bytes)")
    fails = fails + check(write_flat(sSrc, r.body), "kernel source content-addressed into store (.src)")
    println("  source .src : " + sSrc + "  (ca " + srcCA + ")")

    // 2. Build the whole tower in one gated host action: host build-tools into
    //    $P, then the DERIVED toolchain into $TC, then the kernel with CC=/gcc.
    //    `$B` is the ABSOLUTE scratch base captured BEFORE any `cd`.
    btools<String> = "B=\"$PWD/" + buildRoot + "\" && P=\"$B/bt-pfx\" && TC=\"$B/tc-pfx\" && mkdir -p \"$P\" \"$TC\"" +
        // --- host build-tools: bison + flex (kconfig parsers), elfutils (libelf for objtool)
        " && curl -sSL -o \"$B/bison.tar.xz\" \"https://ftp.osuosl.org/pub/gnu/bison/bison-3.8.2.tar.xz\"" +
        " && tar xJf \"$B/bison.tar.xz\" -C \"$B\"" +
        " && cd \"$B/bison-3.8.2\" && ./configure --prefix=\"$P\" --disable-nls && make -j20 && make install" +
        " && curl -sSL -L -o \"$B/flex.tar.gz\" \"https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz\"" +
        " && tar xzf \"$B/flex.tar.gz\" -C \"$B\"" +
        " && cd \"$B/flex-2.6.4\" && ./configure --prefix=\"$P\" && make -j20 && make install" +
        " && curl -sSL -o \"$B/elfutils.tar.bz2\" \"https://sourceware.org/elfutils/ftp/0.191/elfutils-0.191.tar.bz2\"" +
        " && tar xjf \"$B/elfutils.tar.bz2\" -C \"$B\"" +
        " && cd \"$B/elfutils-0.191\" && ./configure --prefix=\"$P\" --disable-debuginfod --disable-libdebuginfod --disable-nls --disable-doc" +
        " && make -j20 && make install" +
        " && export PATH=\"$P/bin:$PATH\" PKG_CONFIG_PATH=\"$P/lib/pkgconfig\" LD_LIBRARY_PATH=\"$P/lib\"" +
        // --- build the DERIVED toolchain into $TC (host cc bootstraps it)
        " && curl -sSL -o \"$B/gmp.tar.xz\" \"https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz\"" +
        " && tar xJf \"$B/gmp.tar.xz\" -C \"$B\" && cd \"$B/gmp-6.3.0\" && ./configure --prefix=\"$TC\" --disable-shared && make -j20 && make install" +
        " && curl -sSL -o \"$B/mpfr.tar.xz\" \"https://www.mpfr.org/mpfr-4.2.1/mpfr-4.2.1.tar.xz\"" +
        " && tar xJf \"$B/mpfr.tar.xz\" -C \"$B\" && cd \"$B/mpfr-4.2.1\" && ./configure --prefix=\"$TC\" --with-gmp=\"$TC\" --disable-shared && make -j20 && make install" +
        " && curl -sSL -o \"$B/mpc.tar.gz\" \"https://www.multiprecision.org/downloads/mpc-1.3.1.tar.gz\"" +
        " && tar xzf \"$B/mpc.tar.gz\" -C \"$B\" && cd \"$B/mpc-1.3.1\" && ./configure --prefix=\"$TC\" --with-gmp=\"$TC\" --with-mpfr=\"$TC\" --disable-shared && make -j20 && make install" +
        " && mkdir -p \"$B/btb\" && curl -sSL -o \"$B/binutils.tar.xz\" \"https://ftp.osuosl.org/pub/gnu/binutils/binutils-2.43.tar.xz\"" +
        " && tar xJf \"$B/binutils.tar.xz\" -C \"$B\" && cd \"$B/btb\" && ../binutils-2.43/configure --prefix=\"$TC\" --disable-nls --disable-werror --disable-shared && make -j20 MAKEINFO=true && make install MAKEINFO=true" +
        // derived as/ld/ar now on PATH; build gcc with host cc driving derived binutils
        " && export PATH=\"$TC/bin:$PATH\" LD_LIBRARY_PATH=\"$TC/lib:$P/lib\"" +
        " && mkdir -p \"$B/gccb\" && curl -sSL -o \"$B/gcc.tar.xz\" \"https://ftp.osuosl.org/pub/gnu/gcc/gcc-13.2.0/gcc-13.2.0.tar.xz\"" +
        " && tar xJf \"$B/gcc.tar.xz\" -C \"$B\" && cd \"$B/gccb\" && ../gcc-13.2.0/configure --prefix=\"$TC\" --enable-languages=c --disable-bootstrap --disable-multilib --with-gmp=\"$TC\" --with-mpfr=\"$TC\" --with-mpc=\"$TC\" --disable-nls --disable-werror --disable-shared --disable-libcc1 --disable-libquadmath --disable-libgomp --disable-libatomic --disable-libsanitizer --disable-libvtv --disable-libssp && make -j20 MAKEINFO=true && make install MAKEINFO=true" +
        // --- compile the DERIVED kernel with the DERIVED gcc, out-of-tree,
        //     BYTE-DETERMINISTICALLY: fixed timestamp/user/host + SOURCE_DATE_EPOCH
        //     + gcc -frandom-seed/-fno-guess-branch-probability, then PROVE it with
        //     a clean second build (same path) -> identical bzImage bytes.
        " && export CC=\"$TC/bin/gcc\" HOSTCC=\"$TC/bin/gcc\"" +
        " && export KBUILD_BUILD_TIMESTAMP=\"Tue Aug 25 2026 00:00:00 +0000\" KBUILD_BUILD_USER=\"vybos\" KBUILD_BUILD_HOST=\"deterministic-rb000\" SOURCE_DATE_EPOCH=1785000000 KCFLAGS=\"-frandom-seed=vybos-rb000 -fno-guess-branch-probability -ffile-prefix-map=$B/=\"" +
        " && " + kcfgOp("$B/kbA", ver) + " && make O=\"$B/kbA\" -j20 bzImage && cp \"$B/kbA/arch/x86/boot/bzImage\" \"$B/kbz1\"" +
        " && " + kcfgOp("$B/kbB", ver) + " && make O=\"$B/kbB\" -j20 bzImage && cp \"$B/kbB/arch/x86/boot/bzImage\" \"$B/kbz2\""

    prep<String> = "rm -rf \"" + buildRoot + "\" && mkdir -p \"" + buildRoot + "\"" +
        " && tar xJf \"" + sSrc + "\" -C \"" + buildRoot + "\" && " + btools
    fails = fails + check(run(prep) == 0, "derived toolchain built; kernel compiled by derived gcc, built twice (bzImage)")

    // 3. byte-determinism PROOF + content-address the bzImage into the NESTED store.
    kbz1<String> = read_flat(buildRoot + "/kbz1")
    kbz2<String> = read_flat(buildRoot + "/kbz2")
    ch1<String> = content_hash(kbz1, name, ver)
    ch2<String> = content_hash(kbz2, name, ver)
    fails = fails + check(ch1.len() == 64 && ch1 == ch2, "BYTE-DETERMINISTIC: identical bzImage across two clean builds (sha " + ch1 + ")")
    bz<String> = kbz2
    fails = fails + check(bz.len() > 5000000, "built bzImage non-trivial (" + bz.len().to_string() + " bytes)")
    fails = fails + check(has_hdrs(bz), "bzImage carries the Linux boot-protocol 'HdrS' signature (0x202)")
    outCA<String> = ch2
    match (mkdir(storeDir + "/" + outCA)) { b -> {} ? -> {} }
    oBin<String> = storeDir + "/" + outCA + "/" + name + "-" + ver + "-bzImage.bin"
    fails = fails + check(write_flat(oBin, bz), "built bzImage content-addressed into NESTED store (store/" + outCA + ")")

    // 4. metadata (records determinism + byte-identical rebuild hash).
    meta<String> = "{\"name\": \"" + name + "\", \"version\": \"" + ver +
        "\", \"sourceUrl\": \"" + srcUrl + "\", \"sourceContentHash\": \"" + srcCA +
        "\", \"buildRecipe\": \"build derived toolchain (gmp/mpfr/mpc/binutils/gcc 13.2.0 C-only) in-scratch; KBUILD_BUILD_TIMESTAMP/USER/HOST fixed + SOURCE_DATE_EPOCH + gcc -frandom-seed/-fno-guess-branch-probability; make O=<kbuild> defconfig + dep-trims + bzImage with CC=<derived-gcc>, built TWICE clean -> identical\", \"outputContentHash\": \"" + outCA +
        "\", \"deterministic\": true, \"rebuildIdentical\": true, \"format\": \"Linux x86 bzImage (HdrS@0x202)\"" +
        ", \"storePath\": \"/vyb/store/" + outCA + "/" + name + "-" + ver + "-bzImage.bin\"}"
    mPath<String> = storeDir + "/" + name + "-" + ver + "-tool.meta.json"
    fails = fails + check(write_flat(mPath, meta), "toolchain metadata written (.meta.json)")

    // 5. FOLD THE BOOT PROOF INTO THE DERIVATION: boot the derived bzImage in
    //    QEMU and gate on VYBOS_READY=1. tools/vybos-run --runtime qemu cooks
    //    a newc initramfs + boots; --test asserts the ready contract and exits
    //   0 on success. Defaults to the HOST qemu (test harness, like host gcc
    //   bootstraps), but VYBOS_QEMU[/LIBDIR/DATA] env can point it at the
    //   DERIVED qemu (build-derive-qemu.vyb). The post-READY "Attempted to
    //   kill init" panic (PID 1 exits after ready) is the EXPECTED stop.
    //   Requires the staged VybOS rootfs (build/rootfs-out), auto-staged if absent.
    bzPath<String> = buildRoot + "/kbB/arch/x86/boot/bzImage"
    bootRc<Int> = run("./tools/vybos-run --runtime qemu --kernel \"" + bzPath + "\" --test")
    fails = fails + check(bootRc == 0, "derived kernel BOOTS the VybOS rootfs to VYBOS_READY=1 in QEMU (dir via VYBOS_QEMU)" + bootRc.to_string())

    println("  output bz  : " + oBin + "  (ca " + outCA + ")")
    println("  toolchain   : DERIVED gcc 13.2.0 + binutils 2.43 (built in-scratch)")
    println("  meta        : " + mPath)
    println("")
    sum<String> = "ALL KERNEL TOOLCHAIN-DERIVATION INVARIANTS PASS"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println(sum)
    if (fails == 0) { return 0 }
    return 1
}
