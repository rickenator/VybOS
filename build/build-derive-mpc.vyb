// build-derive-mpc.vyb — VybOS TOOLCHAIN T0c: mpc (arbitrary-precision COMPLEX
// numbers) as a build-stage derivation. mpc is the 3rd GNU lib in the
// bootstrapped toolchain (gcc links gmp + mpfr + mpc). DEPENDS ON gmp + mpfr.
//
// Pipeline (all vybey + a gated host build action):
//   fetch GNU gmp + mpfr + mpc sources over verified TLS (.tar.xz / .tar.gz)
//   realize all three SOURCES content-addressed into the flat store
//   build gmp   : configure --prefix=<pfx> --disable-shared && make && make install
//   build mpfr  : configure --prefix=<pfx> --with-gmp=<pfx> --disable-shared && make && make install
//   build mpc   : configure --prefix=<pfx> --with-gmp=<pfx> --with-mpfr=<pfx> --disable-shared && make
//   content-address the BUILT libmpc.a + mpc.h + dep-recording .meta.json
//
// Self-contained: builds its gmp + mpfr dependencies into a scratch prefix (a
// proper DAG would consume the REALIZED store artifacts — a note for promotion).
// mpc's archive lives in src/.libs/libmpc.a (mpc builds in src/).
// Flat store, binary-safe String IO.
import collections
import io::{open_read, read_all, close, open_write, write_str}
import process::{exec_run}
import https::{https_get_full_verified}
import http::{HttpResponse}
import url::{url_split, UrlSplit}
import vybos::{content_hash}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

run(cmd<String>)<Int> -> {
    freedom { return exec_run(cmd) else -1 }
}

read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

write_flat(path<String>, content<String>)<Bool> -> {
    ok<Bool> = false
    match (open_write(path)) {
        w -> { n<Int> = write_str(w, content) else -1; close(w); ok = (n >= 0) }
        ? -> { ok = false }
    }
    return ok
}

is_ar_archive(b<String>)<Bool> -> {
    return b.len() >= 8 && b.char_at(0) == 33 && b.char_at(1) == 60 &&
           b.char_at(2) == 97 && b.char_at(3) == 114 && b.char_at(4) == 99 &&
           b.char_at(5) == 104 && b.char_at(6) == 62 && b.char_at(7) == 10
}

// fetch a URL's bytes over verified TLS ("": failure) + realize into store.
fetch_realize(storeDir<String>, url<String>, name<String>, ver<String>,
              tag<String>, ext<String>)<String> -> {
    u<UrlSplit> = url_split(url)
    r<HttpResponse> = https_get_full_verified(u.host, u.port, u.path, "")
    if (r.status != 200) { return "" }
    ca<String> = content_hash(r.body, name, ver)
    if (!write_flat(storeDir + "/" + ca + "-" + name + "-" + ver + "-" + tag + ext, r.body)) { return "" }
    return ca
}

main()<Int> -> {
    storeDir<String> = "store"
    buildRoot<String> = "build/derive-mpc-out"

    gname<String> = "gmp";    gver<String> = "6.3.0"
    mname<String> = "mpfr";   mver<String> = "4.2.1"
    cname<String> = "mpc";    cver<String> = "1.3.1"
    gUrl<String> = "https://gmplib.org/download/gmp/gmp-" + gver + ".tar.xz"
    mUrl<String> = "https://www.mpfr.org/mpfr-" + mver + "/mpfr-" + mver + ".tar.xz"
    cUrl<String> = "https://www.multiprecision.org/downloads/mpc-" + cver + ".tar.gz"

    println("=== VybOS TOOLCHAIN T0c: GNU mpc (deps gmp+mpfr) as a build-stage derivation ===\n")
    fails<Int> = 0

    // 1. fetch + realize all three sources.
    gCA<String> = fetch_realize(storeDir, gUrl, gname, gver, "src", ".tar.xz")
    fails = fails + check(gCA.len() > 0, "gmp source fetched + realized (" + gCA + ")")
    mCA<String> = fetch_realize(storeDir, mUrl, mname, mver, "src", ".tar.xz")
    fails = fails + check(mCA.len() > 0, "mpfr source fetched + realized (" + mCA + ")")
    cCA<String> = fetch_realize(storeDir, cUrl, cname, cver, "src", ".tar.gz")
    fails = fails + check(cCA.len() > 0, "mpc source fetched + realized (" + cCA + ")")

    gSrc<String> = storeDir + "/" + gCA + "-" + gname + "-" + gver + "-src.tar.xz"
    mSrc<String> = storeDir + "/" + mCA + "-" + mname + "-" + mver + "-src.tar.xz"
    cSrc<String> = storeDir + "/" + cCA + "-" + cname + "-" + cver + "-src.tar.gz"

    // 2. build gmp dependency into the scratch prefix (absolute $P, captured BEFORE cd).
    gb<String> = "P=\"$PWD/" + buildRoot + "/gmp-pfx\" && rm -rf \"" + buildRoot + "\" && mkdir -p \"$P\"" +
        " && tar xJf \"" + gSrc + "\" -C \"" + buildRoot + "\"" +
        " && cd \"" + buildRoot + "/" + gname + "-" + gver + "\"" +
        " && ./configure --prefix=\"$P\" --disable-shared" +
        " && make -j4 && make install"
    fails = fails + check(run(gb) == 0, "gmp dependency built into scratch prefix ($P)")

    // 3. build mpfr dependency against the (absolute) gmp prefix.
    mb<String> = "P=\"$PWD/" + buildRoot + "/gmp-pfx\" && tar xJf \"" + mSrc + "\" -C \"" + buildRoot + "\"" +
        " && cd \"" + buildRoot + "/" + mname + "-" + mver + "\"" +
        " && ./configure --prefix=\"$P\" --with-gmp=\"$P\" --disable-shared" +
        " && make -j4 && make install"
    fails = fails + check(run(mb) == 0, "mpfr dependency built against gmp")

    // 4. build mpc against the (absolute) gmp+mpfr prefix.
    cb<String> = "P=\"$PWD/" + buildRoot + "/gmp-pfx\" && tar xzf \"" + cSrc + "\" -C \"" + buildRoot + "\"" +
        " && cd \"" + buildRoot + "/" + cname + "-" + cver + "\"" +
        " && ./configure --prefix=\"$P\" --with-gmp=\"$P\" --with-mpfr=\"$P\" --disable-shared" +
        " && make -j4"
    fails = fails + check(run(cb) == 0, "mpc configured+built against gmp+mpfr")

    // 5. content-address the BUILT mpc archive + header.
    lib<String> = read_flat(buildRoot + "/" + cname + "-" + cver + "/src/.libs/libmpc.a")
    if (lib.len() < 1000) { lib = read_flat(buildRoot + "/" + cname + "-" + cver + "/.libs/libmpc.a") } // fallback: top-level
    fails = fails + check(lib.len() > 100000, "built libmpc.a non-trivial (" + lib.len().to_string() + " bytes)")
    fails = fails + check(is_ar_archive(lib), "libmpc.a is a valid ar archive")
    outCA<String> = content_hash(lib, cname, cver)
    oBin<String> = storeDir + "/" + outCA + "-" + cname + "-" + cver + ".bin"
    fails = fails + check(write_flat(oBin, lib), "built libmpc.a content-addressed into store (.bin, ca " + outCA + ")")

    hdr<String> = read_flat(buildRoot + "/" + cname + "-" + cver + "/src/mpc.h")
    fails = fails + check(hdr.len() > 1000, "mpc.h header produced (" + hdr.len().to_string() + " bytes)")

    // 6. metadata (records both dependency output hashes).
    meta<String> = "{\"name\": \"" + cname + "\", \"version\": \"" + cver +
        "\", \"sourceUrl\": \"" + cUrl + "\", \"sourceContentHash\": \"" + cCA +
        "\", \"deps\": [\"gmp:" + gver + "\", \"mpfr:" + mver + "\"]" +
        "\", \"gmpSourceContentHash\": \"" + gCA + "\", \"mpfrSourceContentHash\": \"" + mCA +
        "\", \"buildRecipe\": \"configure --with-gmp=<pfx> --with-mpfr=<pfx> --disable-shared && make\", \"outputContentHash\": \"" + outCA +
        "\", \"storePath\": \"/vyb/store/" + outCA + "-" + cname + "-" + cver + ".bin\"}"
    mPath<String> = storeDir + "/" + cname + "-" + cver + "-tool.meta.json"
    fails = fails + check(write_flat(mPath, meta), "toolchain metadata written (.meta.json)")
    println("  output .bin : " + oBin + "  (ca " + outCA + ")")
    println("  deps        : gmp " + gver + " + mpfr " + mver + " (scratch; store-input DAG is a follow-on)")
    println("  meta        : " + mPath)
    println("")
    sum<String> = "ALL MPC TOOLCHAIN-DERIVATION INVARIANTS PASS"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println(sum)
    if (fails == 0) { return 0 }
    return 1
}
