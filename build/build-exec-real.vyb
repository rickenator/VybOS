// build-exec-real.vyb — VybOS: the FULL compose -> plan -> execute pipeline
// with the EXECUTION half running over REAL HTTPS (verified TLS), not the
// deterministic httpbin mirror.
//
// build-exec.vyb runs the same pipeline but realises via the name-keyed httpbin
// mirror (build-build mirrors). This slice keeps module-composition + plan, and
// swaps ONLY the execution step: each package is fetched from ITS OWN real
// `source` URL over genuine TLS (https_get_full_verified + system CA) via the
// shared URL-realizer (modules/urlrealize.vyb -> realize_spec_url -> fetch_url).
//
// Pipeline:
//   config (modules sshd/getty/vim + nginx) -> compose() -> SystemSpec
//   -> compose_issue gate (no side effects before this)
//   -> plan_lines(cur, des)         (the dry-run, unchanged from build-exec)
//   -> realize_spec_url(storeDir, des)  (EXECUTE over real HTTPS, per-pkg URL)
//   -> verify realised accounts match the plan's install set.
//
// Sources are REAL packages fetched over real TLS:
//   openssh 9.8p1  https://cdn.openbsd.org/.../openssh-9.8p1.tar.gz   (~1.9MB)
//   vim 9.1        https://codeload.github.com/vim/vim/tar.gz/.../v9.1.0 (~17MB)
//   nginx 1.26.2   https://nginx.org/download/nginx-1.26.2.tar.gz     (~1.2MB)
// vim's source is the DIRECT codeload endpoint (github.com/.../archive/v9.1
// is not an exact ref; refs/tags/v9.1.0 is). Now that #194 is fixed (5656c62),
// the canonical github.com/<o>/<r>/archive/refs/tags/v9.1.0.tar.gz would work
// too (redirects followed, bounded 10 hops); the direct URL stays for fewer hops.
//
// NOTE: this slice REALLY downloads ~20MB over TLS each run — it is the honest
// end-to-end integration slice, not a fast deterministic unit slice.
import collections
import http
import https
import io
import io::{open_write, write_str, close, open_read, read_all}
import vybos::{content_hash}
import url::{url_split, UrlSplit}
import plan::{Pkg, Dep, SystemSpec, RealRec, resolve, real_table, real_of,
              find_pkg, order_count, token_kth, plan_lines}
import realize::{realize_one, meta_inputs, closure_real, RealizeResult}
import urlrealize::{realize_spec_url, UrlRealizeResult}
import compose::{Module, blank_system, compose, compose_issue}
import sshd::{sshd}
import getty::{getty}
import vim::{vim}
import nginx::{nginx}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

// naive substring test.
substr_has(h<String>, nd<String>)<Bool> -> {
    hl<Int> = h.len()
    nl<Int> = nd.len()
    if (nl > hl) { return false }
    for (i in 0..hl-nl) {
        ok<Bool> = true
        for (j in 0..nl-1) {
            if (h.char_at(i + j) != nd.char_at(j)) { ok = false; break }
        }
        if (ok) { return true }
    }
    return false
}

plan_installs(plan<String>, name<String>)<Bool> -> {
    return substr_has(plan, "install " + name + "\n")
}
plan_keeps(plan<String>, name<String>)<Bool> -> {
    return substr_has(plan, "keep " + name + "\n")
}

read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

// assemble a SystemSpec from an arbitrary enabled/disabled module set.
assemble(sshdOn<Bool>, gettyOn<Bool>, vimOn<Bool>, nginxOn<Bool>)<SystemSpec> -> {
    mods<Vec<Module>> = Vec()
    mods.push(sshd(sshdOn))
    mods.push(getty(gettyOn))
    mods.push(vim(vimOn))
    mods.push(nginx(nginxOn))
    return compose(blank_system("x86_64-linux", "vybos-exec-real"), mods)
}

main()<Int> -> {
    storeDir<String> = "store"
    println("=== VybOS: module-composed apply EXECUTION over REAL HTTPS (verified TLS) ===\n")
    fails<Int> = 0

    // cur: sshd + getty + vim. des: + nginx (an install transition to run).
    cur<SystemSpec> = assemble(true, true, true, false)
    des<SystemSpec> = assemble(true, true, true, true)

    // 1. gate before any side effect.
    issue<String> = compose_issue(des)
    fails = fails + check(issue == "", "desired spec composes clean (gate pass)")

    // 2. dry-run plan (what SHOULD change).
    plan<String> = plan_lines(cur, des)
    fails = fails + check(plan_installs(plan, "nginx"),   "dry-run says install nginx")
    fails = fails + check(plan_keeps(plan, "openssh"),    "dry-run says keep openssh")
    fails = fails + check(plan_keeps(plan, "vim"),        "dry-run says keep vim")
    println("  --- dry-run plan (cur -> des) ---")
    println(plan)

    // 3. EXECUTE over REAL HTTPS: each pkg fetched from its OWN real source
    //    URL over verified TLS (no httpbin mirror).
    println("  --- REAL HTTPS realization of the desired closure (this downloads ~20MB) ---")
    res<UrlRealizeResult> = realize_spec_url(storeDir, des)
    fails = fails + check(res.failed == 0, "all desired pkgs realise over real HTTPS with no failures")
    fails = fails + check(res.realised == 3, "exactly the 3 desired pkgs realised (openssh, vim, nginx)")
    fails = fails + check(des.pkgs.len() == 3, "desired spec really holds 3 packages")

    // 4. on-disk spot-check: each pkg realises to .src + .meta.json, and the
    //    meta records the pkg's OWN real HTTPS source URL (not a mirror).
    for (k in 0..des.pkgs.len()-1) {
        p<Pkg> = des.pkgs.get(k)
        real<Int> = closure_real(des, p.name)
        mp<String> = storeDir + "/" + real.to_string() + "-" + p.name + "-" + p.version + ".meta.json"
        sp<String> = storeDir + "/" + real.to_string() + "-" + p.name + "-" + p.version + ".src"
        rawM<String> = read_flat(mp)
        fails = fails + check(real > 0, p.name + " has a positive closure-real identity")
        fails = fails + check(substr_has(rawM, "\"name\": \"" + p.name + "\""), p.name + " .meta.json exists on disk")
        fails = fails + check(substr_has(rawM, "\"source\": \"" + p.source + "\""), p.name + " meta records its OWN real HTTPS source")
        fails = fails + check(read_flat(sp).len() > 0, p.name + " .src blob written (" + read_flat(sp).len().to_string() + " bytes)")
    }

    println("")
    println("  realised=" + res.realised.to_string() + " failed=" + res.failed.to_string())
    println("  topological order: " + res.order)
    println("  store dir: " + storeDir + "/  (real HTTPS source + .meta.json per derivation)")
    println("")

    sum<String> = "ALL REAL-HTTPS APPLY-EXECUTION INVARIANTS PASS"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println(sum)
    if (fails == 0) { return 0 }
    return 1
}
