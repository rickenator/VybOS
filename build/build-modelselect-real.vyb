// build-modelselect-real.vyb — VybOS MODEL-SELECTION Checkpoint C: the REAL
// Qwen3-4B as a SIGNED registry entry + end-to-end USER any-model load through
// select_model / boot_model, dogfooded with the real artifact.
//
// (doc/MODEL-SELECTION.md; VYBLLM-ARCHITECTURE §4 step 4-5.)
//
// What this proves beyond checkpoints A+B (selection+verification over fixture
// records):
//   1. a signed model-registry entry whose record commits to the REAL Qwen3-4B
//      artifact (GGUF sha256 + tokenizer vocab/merges hashes),
//   2. a user any-model load: /etc/vybos.md assigns a role to the real model,
//      boot_model/select_model resolve + verify it against the signed registry
//      (unprivileged, credential-free — user any-model is NOT root-gated),
//   3. the selected dir actually LOADS: model_load(name, dir) then
//      model_encode / model_decode on the real tokenizer artifacts dir produce
//      the committed deterministic ids (cross-checked in VybForge) and a
//      faithful encode->decode round trip — selection drives a REAL load, not a
//      path formality.
//
// Key/credential material is RFC 8032 TEST seeds + a scaffold root token —
// caller-supplied, never embedded in the runtime (security convention).
//
// The real tokenizer dir is read from VYB_LLM_DIR; it MUST contain
// {vocab.json, merges.txt}. Encode expectations are the committed VybForge ids.
//
// Run:  VYB_STDLIB=$VYB_STDLIB build/vyb build/build-modelselect-real.vyb --module-path modules

import modelselect::{ModelSel, select_model, BootSel, boot_model}
import vybconfig::{VybConfig, parse_md}
import packagerecord::{Patch, ModuleRecord, record_root, seal_module_record}
import ledger::{registry_genesis, apply_op, PkgOp, state_root}
import chain::{SignedChain}
import crypto::{ed25519_publickey}
import vllm::{model_load, model_encode, model_decode, Model}
import env::{env_get}

check(c<Bool>, l<String>)<Int> -> {
    if (!c) { println("  FAIL " + l); return 1 }
    println("  ok   " + l)
    return 0
}

// Build the signed model package-record for the REAL Qwen3-4B. `artifact` is
// the GGUF content hash; tokenizer hashes ride as generated-provenance patches.
mkRealRec(seed<String>, artifact<String>, vocabH<String>, mergesH<String>)<ModuleRecord> -> {
    p1<Patch> = Patch { id = "vocab",   hash = vocabH, cls = "generated", generator = "qwen-vocab",   prompt = "tokenizer vocab.json", response = "real BPE vocab" }
    p2<Patch> = Patch { id = "merges",  hash = mergesH, cls = "generated", generator = "qwen-merges", prompt = "tokenizer merges.txt", response = "real BPE merges" }
    pats<Vec<Patch>> = Vec(); pats.push(p1); pats.push(p2)
    return ModuleRecord {
        name = "qwen3-4b", version = "1.0.0", target = "x86_64-linux", namespace = "vyos-models",
        upstreamRepo = "huggingface/Qwen3-4B-GGUF", upstreamRevision = "v1",
        pristineHash = "h_pristine_qwen3", closure = "qwen3-4b@1.0.0",
        toolchain = "Vyb 0.7.x", buildFlags = "-q4", builderId = "vybforge-builder",
        validation = "eval:26/26", artifactHash = artifact,
        publisherSeed = seed, timestamp = "2026-09-11T00:00:00Z", patches = pats
    }
}

sealRec(rec<ModuleRecord>, seed<String>)<SignedChain> -> {
    return seal_module_record(rec, "vybforge/models", seed)
}

main()<Int> -> {
    fails<Int> = 0
    # keys (RFC 8032 TEST seeds) + root credential (scaffold-only)
    seed1<String> = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    seed2<String> = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    publisher<String> = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    regPub<String> = ed25519_publickey(seed1)
    otherPub<String> = ed25519_publickey(seed2)
    rootToken<String> = "root-capability-v1"
    storeRoot<String> = "store/models"

    # ---- REAL artifact commitments (from on-box files, 2026-09-11) ----
    ggufH<String> = "899e910ac7d04373bedca377"          # Qwen3-4B-Q4_K_M.gguf sha256 (prefix)
    vocabH<String> = "ca10d7e9fb3ed185"                  # vocab.json sha256 (prefix)
    mergesH<String> = "8831e4f1a0444713"                 # merges.txt sha256 (prefix)

    # ---- signed model registry: publish the REAL model ----
    reg<SignedChain> = registry_genesis("vymodels", "model-registry-v1", seed1)
    reg = apply_op(reg, PkgOp { kind = "publish", name = "qwen3-4b", version = "1.0.0", stage = "", hash = ggufH }, seed1)
    ledgerRoot<String> = state_root(reg)

    realRec<ModuleRecord> = mkRealRec(publisher, ggufH, vocabH, mergesH)
    realSc<SignedChain> = sealRec(realRec, seed1)
    records<Vec<SignedChain>> = Vec(); records.push(realSc)
    roots<Vec<String>> = Vec(); roots.push(record_root(realRec))

    # 1. signed record commits the real artifact hashes
    fails = fails + check(realRec.artifactHash == ggufH, "signed record commits the real GGUF hash")
    fails = fails + check(realRec.patches.get(0).hash == vocabH && realRec.patches.get(1).hash == mergesH, "signed record commits tokenizer vocab+merges hashes")

    # 2. user any-model SELECT against the signed registry (unprivileged -> ok)
    usel<ModelSel> = select_model("user", "qwen3-4b@1.0.0", reg, records, roots, regPub, ledgerRoot, storeRoot, rootToken, "")
    fails = fails + check(usel.ok, "user any-model select: real qwen3-4b@1.0.0 verified against signed registry")
    fails = fails + check(usel.name == "qwen3-4b" && usel.version == "1.0.0", "select: real model name+version resolved")
    fails = fails + check(usel.dir == storeRoot + "/qwen3-4b-1.0.0", "select: dir is content-addressed storeRoot/name-ver")

    # 3. tamper the signed real model's artifact hash -> rejected (signature gate)
    # (rebuild a forged record with a WRONG artifact under the same seal path
    #  is not meaningful at the record level; instead anchor with the wrong key)
    h<ModelSel> = select_model("admin", "qwen3-4b@1.0.0", reg, records, roots, otherPub, ledgerRoot, storeRoot, rootToken, rootToken)
    fails = fails + check(!h.ok, "real model selection rejected under wrong registry pubkey (signature gate)")

    # 4. user any-model load through BOOT (config-driven), unprivileged -> ok
    conf<VybConfig> = parse_md("# vybos\nhostname = hera\n## models\n- admin qwen3-4b@1.0.0\n- user qwen3-4b@1.0.0\n")
    bu<BootSel> = boot_model(conf, "user", reg, records, roots, regPub, ledgerRoot, storeRoot, rootToken, "")
    fails = fails + check(bu.ok, "boot: user any-model resolved (real qwen3-4b) unprivileged")
    fails = fails + check(!bu.cred_required, "boot: user any-model is NOT root-gated")
    fails = fails + check(bu.dir == storeRoot + "/qwen3-4b-1.0.0", "boot: real model dir content-addressed")

    # 5. the selected dir actually LOADS + tokenizes on the real artifact.
    #    VYB_LLM_DIR points at the real tokenizer dir ({vocab.json, merges.txt}).
    tdir<String> = env_get("VYB_LLM_DIR") else "artifacts/vybos-configurator-lora"
    m<Model> = model_load(bu.name, tdir)
    # committed deterministic ids for "The capital of France is" (VybForge gold)
    ids<Vec<Int>> = model_encode(m, "The capital of France is")
    gold1<Int> = 785; gold2<Int> = 6722; gold3<Int> = 315; gold4<Int> = 9625; gold5<Int> = 374
    fails = fails + check(ids.len() == 5, "real encode: 5 tokens for 'The capital of France is'")
    fails = fails + check(ids.get(0) == gold1 && ids.get(1) == gold2 && ids.get(2) == gold3 && ids.get(3) == gold4 && ids.get(4) == gold5, "real encode: ids == VybForge gold [785,6722,315,9625,374]")

    # 6. encode -> decode round trip on the real artifact is faithful
    ids2<Vec<Int>> = model_encode(m, "hello world")
    rt<String> = model_decode(m, ids2)
    fails = fails + check(rt == "hello world", "real decode: encode->decode round trip ('hello world')")

    sum<String> = "MODEL-SELECT-REAL: PASS (real Qwen3-4B signed registry entry + user any-model load through select/boot, loaded on the real tokenizer)"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println("\n" + sum)
    if (fails == 0) { return 0 }
    return 1
}
