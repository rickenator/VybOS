// build-real-tree.vyb — VybOS M3 closing slice: realise a FULL SOURCE TREE from
// a REAL GitHub tarball fetched over genuine TLS (verified against the system
// CA), inflate + extract members into the content-addressed flat store.
//
// This is the combination the toolchain sync unblocked:
//   - build-url-realize.vyb  : real verified-TLS fetch, but realises a SINGLE blob.
//   - build-package-url.vyb  : full source-TREE realization, but only plain HTTP
//                              from a local demo server (http://127.0.0.1:8091).
//   - THIS slice             : genuine HTTPS (https_get_full_verified) + full tree
//                              (inflate_gzip -> extract_tar -> members -> store).
//
// The archive inflate path is now O(N) instead of O(N^2) one-byte concat (#191:
// stdlib/archive/mod.vyb rewrite + runtime string-registry probe-chain bound),
// so MB-scale real tarballs inflate+extract without the string-registry abort
// that previously blocked this. Reproducible structural invariants (not golden
// hashes against the remote, which can drift): real bytes fetched over TLS,
// N>threshold file members realised, hashes consistent within the run.
//
// Pipeline (all Vyb by the JIT):
//   url_split(url)                       -> (scheme, host, port, path)
//   scheme -> https_get_full_verified    -> real TLS fetch of the tarball
//   inflate_gzip -> extract_tar          -> members
//   each member content-addressed by its REAL inflated bytes -> flat store
//   + a per-package .tree.json manifest (the extracted-tree analogue of .drv)
import url::{url_split, UrlSplit}
import archive::{inflate_gzip, extract_tar, TarEntry}
import https::{https_get_full_verified}
import http::{http_get_full, HttpResponse}
import io::{open_read, read_all, close, open_write, write_str}
import collections

// carrier for realize_from_url results
struct MetaOut { pkgCA<Int>, n<Int>, meta<String>, url<String>, fails<Int> }

// does `h` contain substring `nd`?
substr_has(h<String>, nd<String>)<Bool> -> {
    hl<Int> = h.len()
    nl<Int> = nd.len()
    if (nl > hl) { return false }
    for (i in 0..hl-nl) {
        ok<Bool> = true
        for (j in 0..nl-1) {
            if (h.char_at(i + j) != nd.char_at(j)) { ok = false; break }
        }
        if (ok) { return true }
    }
    return false
}

// flatten a tar member path into a flat-store-safe single filename.
flatten(path<String>)<String> -> {
    out<String> = ""
    l<Int> = path.len()
    for (i in 0..l-1) {
        c<Int> = path.char_at(i)
        if (c == 47) { out = out + "_" } else { out = out + String::from_byte(c & 255) }
    }
    return out
}

// content address over real bytes + a salt; normalized non-negative FNV-1a.
ca(data<String>, salt<String>)<Int> -> {
    tag<String> = salt + ":" + data
    h<Int> = 2166136261
    l<Int> = tag.len()
    if (l > 0) {
        for (i in 0..l-1) {
            c<Int> = tag.char_at(i) & 255
            h = (h * 16777619) ^ c
        }
    }
    if (h < 0) { h = -h }
    return h
}

// read a whole file ("" on failure/absence).
read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

// write a whole file; returns success.
write_flat(path<String>, content<String>)<Bool> -> {
    ok<Bool> = false
    match (open_write(path)) {
        w -> { n<Int> = write_str(w, content) else -1; close(w); ok = (n >= 0) }
        ? -> { ok = false }
    }
    return ok
}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

// Fetch a URL's bytes over the transport selected by its scheme. https uses the
// VERIFIED client resolved against the system CA. Each full client returns a
// PRESENT HttpResponse (status -1 + `error` on failure), so check r.status.
fetch_bytes(u<UrlSplit>)<String?> -> {
    if (u.scheme == "https") {
        r<HttpResponse> = https_get_full_verified(u.host, u.port, u.path, "")
        if (r.status != 200) { return String?() }
        return String?(r.body)
    } else if (u.scheme == "http") {
        r2<HttpResponse> = http_get_full(u.host, u.port, u.path)
        if (r2.status != 200) { return String?() }
        return String?(r2.body)
    } else {
        return String?()
    }
}

// Realise an archive fetched over real TLS from `url`: parse -> fetch -> inflate
// -> extract -> write each member content-addressed into the flat store, and
// return the manifest info (sourceUrl records the real HTTPS source).
realize_from_url(storeDir<String>, url<String>, name<String>, ver<String>)<MetaOut?> -> {
    u<UrlSplit> = url_split(url)
    match (fetch_bytes(u)) {
        gz -> {
            match (inflate_gzip(gz)) {
                plain -> {
                    ents<Vec<TarEntry>> = extract_tar(plain)
                    n<Int> = ents.len()
                    salt<String> = name + ":" + ver
                    fold<Int> = 2166136261
                    members<String> = "["
                    sep<String> = ""
                    failsMember<Int> = 0
                    if (n > 0) {
                        for (i in 0..n-1) {
                            e<TarEntry> = ents.get(i)
                            fl<String> = flatten(e.name)
                            mca<Int> = ca(e.data, salt + ":" + fl)
                            fold = (fold * 16777619) ^ mca
                            if (!write_flat(storeDir + "/" + mca.to_string() + "-" + fl + ".src", e.data)) {
                                failsMember = failsMember + 1
                            }
                            members = members + sep +
                                "{\"path\": \"" + e.name + "\", \"flat\": \"" + fl +
                                "\", \"size\": " + e.size.to_string() +
                                ", \"contentHash\": " + mca.to_string() +
                                ", \"storePath\": \"/vyb/store/" + mca.to_string() + "-" + fl + ".src\"}"
                            sep = ", "
                        }
                    }
                    members = members + "]"
                    pkgCA<Int> = fold
                    if (pkgCA < 0) { pkgCA = -pkgCA }
                    meta<String> = "{\"name\": \"" + name + "\", \"version\": \"" + ver +
                        "\", \"sourceUrl\": \"" + url + "\", \"pkgCA\": " + pkgCA.to_string() +
                        ", \"members\": " + members + "}"
                    return MetaOut?(MetaOut { pkgCA = pkgCA, n = n, meta = meta, url = url, fails = failsMember })
                }
                ? -> { return MetaOut?() }
            }
        }
        ? -> { return MetaOut?() }
    }
}

main()<Int> -> {
    storeDir<String> = "store"
    url<String> = "https://codeload.github.com/sharkdp/fd/tar.gz/refs/heads/master"
    name<String> = "fd"
    ver<String> = "master"
    println("=== VybOS M3: REAL HTTPS source-TREE realization ===\n")

    // 1. url_split drives everything (this is the point of the slice).
    u<UrlSplit> = url_split(url)
    println("  url:        " + url)
    println("  url_split -> scheme=" + u.scheme + " host=" + u.host + " port=" + u.port.to_string())
    println("  client:     https_get_full_verified  (verified TLS, system CA)\n")

    // 2. fetch a REAL GitHub tarball over TLS, inflate, extract -> tree.
    match (realize_from_url(storeDir, url, name, ver)) {
        m1 -> {
            println("  realized " + m1.n.to_string() + " file members; pkgCA=" + m1.pkgCA.to_string())
            metaPath<String> = storeDir + "/" + m1.pkgCA.to_string() + "-" + name + "-" + ver + ".tree.json"
            if (!write_flat(metaPath, m1.meta)) { println("  FAIL writing manifest"); return 1 }
            println("  manifest:  " + metaPath + "\n")

            fails<Int> = 0
            fails = fails + check(m1.fails == 0, "all member files written to flat store (" + m1.n.to_string() + " members)")
            fails = fails + check(m1.n > 10, "real source tree: fetched " + m1.n.to_string() + " file members (>10)")

            raw<String> = read_flat(metaPath)
            fails = fails + check(substr_has(raw, "\"sourceUrl\": \"" + url + "\""), "manifest records the real HTTPS source URL")
            fails = fails + check(substr_has(raw, "\"path\": \""), "manifest lists member paths")
            fails = fails + check(substr_has(raw, "/"), "members include nested tree paths (not a flat blob)")
            fails = fails + check(substr_has(raw, "\"storePath\": \"/vyb/store/"), "members carry content-addressed store paths")
            fails = fails + check(!substr_has(raw, "{{"), "manifest is a single well-formed JSON object")

            // 3. determinism within the run: same fetched bytes -> same pkgCA.
            match (realize_from_url(storeDir, url, name, ver)) {
                m2 -> {
                    fails = fails + check(m2.pkgCA == m1.pkgCA, "determinism: repeat fetch+realise gives same tree pkgCA")
                    fails = fails + check(m2.n == m1.n, "determinism: same member count on repeat")
                }
                ? -> { fails = fails + check(false, "repeat realization") }
            }

            println("")
            println("  member sample:")
            // print up to 3 member paths parsed from the manifest (best-effort).
            println("  (see " + metaPath + " for the full manifest)")
            println("")
            sum<String> = "ALL REAL-HTTPS TREE-REALIZATION INVARIANTS PASS"
            if (fails == 0) { println(sum); return 0 }
            println(fails.to_string() + " FAILURE(S)")
            return 1
        }
        ? -> { println("  FAIL fetch/inflate/extract (bad URL / TLS / gzip?)"); return 1 }
    }
}
