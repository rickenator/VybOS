// build-reprobuild-gcc.vyb — gcc INDEPENDENT-BUILD byte-reproducibility proof.
//
// Builds the DERIVED toolchain tower (gmp/mpfr/mpc/binutils/gcc) TWICE into two
// completely separate build roots (different paths), under SOURCE_DATE_EPOCH +
// -ffile-prefix-map + a PINNED install spec, and asserts the gcc driver and
// cc1 are byte-identical across the two independent builds.
import collections
import io::{open_read, read_all, close, open_write, write_str}
import process::{exec_run}
import https::{https_get_full_verified}
import url::{url_split, UrlSplit}
import http::{HttpResponse}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

run(c<String>)<Int> -> {
    freedom { return exec_run(c) else -1 }
}

read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

// Build the tower once into base/<tag>/{pfx,src...} and copy gcc+cc1 out.
// gcc is built against the in-scratch gmp/mpfr/mpc/binutils in the same pfx.
fetch_to(base<String>, url<String>, outname<String>)<Bool> -> {
    u<UrlSplit> = url_split(url)
    r<HttpResponse> = https_get_full_verified(u.host, u.port, u.path, "")
    if (r.status != 200) { return false }
    match (open_write(base + "/" + outname)) {
        w -> { write_str(w, r.body); close(w); return true }
        ? -> { return false }
    }
}

build_once(base<String>, tag<String>)<Bool> -> {
    rec<String> = "B=$PWD/" + base + " && G=$B/" + tag + " && P=$B/pfx && rm -rf $G $P && mkdir -p $P" +
        " && export SOURCE_DATE_EPOCH=1785000000 CFLAGS=-ffile-prefix-map=$B=/p" +
        // deps into $P (pinned install): gmp -> mpfr -> mpc -> binutils
        " && cd $G && tar xJf $B/gmp-6.3.0.tar.xz && cd gmp-6.3.0" +
        " && ./configure --prefix=$P/fp --disable-shared && make -j4 && make install" +
        " && cd $G && tar xJf $B/mpfr-4.2.1.tar.xz && cd mpfr-4.2.1" +
        " && ./configure --prefix=$P/fp --with-gmp=$P/fp --disable-shared && make -j4 && make install" +
        " && cd $G && tar xJf $B/mpc-1.3.1.tar.gz && cd mpc-1.3.1" +
        " && ./configure --prefix=$P/fp --with-gmp=$P/fp --with-mpfr=$P/fp --disable-shared && make -j4 && make install" +
        " && cd $G && tar xJf $B/binutils-2.43.tar.xz && mkdir -p $G/btb && cd $G/btb" +
        " && $G/binutils-2.43/configure --prefix=$P/fp --disable-nls --disable-werror --disable-shared --disable-gprofng" +
        " && make -j4 MAKEINFO=true && make install MAKEINFO=true" +
        // gcc against the derived deps
        " && cd $G && tar xJf $B/gcc-13.2.0.tar.xz && mkdir -p $G/gccb && cd $G/gccb" +
        " && $G/gcc-13.2.0/configure --prefix=$P/fp --enable-languages=c --disable-bootstrap --disable-multilib" +
        " --with-gmp=$P/fp --with-mpfr=$P/fp --with-mpc=$P/fp --disable-nls --disable-werror --disable-shared" +
        " --disable-libcc1 --disable-libquadmath --disable-libgomp --disable-libatomic --disable-libsanitizer --disable-libvtv --disable-libssp" +
        " && make -j4 MAKEINFO=true && make install MAKEINFO=true" +
        " && cp $P/fp/bin/gcc $B/" + tag + "-gcc" +
        " && cp $P/fp/libexec/gcc/x86_64-pc-linux-gnu/13.2.0/cc1 $B/" + tag + "-cc1"
    return run(rec) == 0
}


main()<Int> -> {
    base<String> = "build/reprogcc-out"
    fails<Int> = 0
    fails = fails + check(run("rm -rf " + base + " && mkdir -p " + base) == 0, "clean + made base dir")

    // fetch the 5 tower sources (verified TLS) once, shared by both builds.
    fails = fails + check(fetch_to(base, "https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz", "gmp-6.3.0.tar.xz"), "fetched gmp")
    fails = fails + check(fetch_to(base, "https://www.mpfr.org/mpfr-4.2.1/mpfr-4.2.1.tar.xz", "mpfr-4.2.1.tar.xz"), "fetched mpfr")
    fails = fails + check(fetch_to(base, "https://www.multiprecision.org/downloads/mpc-1.3.1.tar.gz", "mpc-1.3.1.tar.gz"), "fetched mpc")
    fails = fails + check(fetch_to(base, "https://ftp.osuosl.org/pub/gnu/binutils/binutils-2.43.tar.xz", "binutils-2.43.tar.xz"), "fetched binutils")
    fails = fails + check(fetch_to(base, "https://ftp.osuosl.org/pub/gnu/gcc/gcc-13.2.0/gcc-13.2.0.tar.xz", "gcc-13.2.0.tar.xz"), "fetched gcc")

    // two INDEPENDENT builds (separate roots a/ and b/).
    fails = fails + check(build_once(base, "a"), "build A (root build/reprogcc-out/a)")
    fails = fails + check(build_once(base, "b"), "build B (root build/reprogcc-out/b)")

    // byte-compare gcc driver + cc1 across the independent builds.
    fails = fails + check(read_flat(base + "/a-gcc") == read_flat(base + "/b-gcc") &&
                          read_flat(base + "/a-gcc").len() > 5000000,
                          "gcc driver byte-identical across independent builds (A vs B)")
    fails = fails + check(read_flat(base + "/a-cc1") == read_flat(base + "/b-cc1") &&
                          read_flat(base + "/a-cc1").len() > 10000000,
                          "cc1 byte-identical across independent builds (A vs B)")

    if (fails == 0) { println("REPROBUILD:GCC:PASS") } else { println("REPROBUILD:GCC:FAILURE") }
    return 0
}
