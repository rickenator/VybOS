// build-securegen.vyb — VybChain Phase 3: SECURE GENERATION BUILDER.
//
// Wires the §5 verify-before-install gate into the BOOTABLE system's package
// path. The chain is the real one a system generation goes through:
//
//   compose   a real module-composed SystemSpec (sshd + getty + userspace pkg)
//   plan      resolve the topological closure order
//   verify    publish every closure pkg into the registry ledger (Ed25519),
//             sign the checkpoint, run the §5 gate (trusted segment +
//             artifact audit + system state root) — REFUSE unless ok:all
//   record    seal the full §2 package record for the installed system
//   build     stage the generation tree with the verified state root baked in
//             (/etc/vyb-os/ledger-root; /init echoes LEDGER_ROOT=...), build
//             the bootable ext4 image (B5 path), content-address it
//   legit     seal a SIGNED boot-legitimization chain over
//             (generation, derived-kernel store id, image sha256, state root),
//             persist the receipt, re-verify after a disk round-trip, and
//             prove a tampered receipt is caught
//
// The produced image boots via:
//   ./tools/vybos-run --runtime qemu --disk build/securegen-out/securegen-gen1.img --test
// and the console must show LEDGER_ROOT equal to the gate's state root —
// proving the bootable system was built ONLY from ledger-verified artifacts.
//
// Source bytes are synthesized deterministically (offline, reproducible), the
// same convention as build-install.vyb; key material = RFC 8032 TEST seeds
// (scaffold-only, tests never ship keys).
//
// Run: $VYB build/build-securegen.vyb --module-path modules

import collections
import io::{open_read, read_all, close, open_write, write_str}
import process::{exec_run, exec_output}
import compose::{Module, blank_system, compose}
import plan::{SystemSpec, Pkg, Dep, spec_digest, resolve, find_pkg, order_count, token_kth}
import gensys::{FileEntry, gen_dir, gen_entries, etc_link_target}
import sshd::{sshd}
import getty::{getty}
import ledger::{registry_genesis, apply_op, sign_ledger_checkpoint, PkgOp}
import verifyinstall::{Artifact, system_state_root, verify_before_install}
// NOTE: importing realize::{verify_closure} here makes `Pkg` unresolvable in
// this file (toolchain splice/lookup quirk — minimal repro pinned in
// repro/probe_realize_pkg_lookup.vyb); verify_before_install is the same §5
// gate returning Bool, exported straight from verifyinstall.
import chain::{SignedChain, Chain, deserialize, verify, serialize, tip_hash}
import crypto::{ed25519_publickey, sha256}
// NOTE: importing vybos::{content_hash} (or realize::{verify_closure}) makes
// `Pkg` unresolvable in this file — toolchain splice/lookup quirk, minimal
// repro pinned in repro/probe_realize_pkg_lookup.vyb. content_hash is exactly
// sha256(name + ":" + version + ":" + bytes), so we inline it as chash() below.
import packagerecord::{ModuleRecord, record_root, seal_module_record, is_legit_record}
import bootlegit::{seal_boot_signed, is_legit_signed, sign_boot_checkpoint, verify_boot_checkpoint}

check(c<Bool>, l<String>)<Int> -> {
    if (!c) { println("  FAIL " + l); return 1 }
    println("  ok   " + l)
    return 0
}

run(cmd<String>)<Int> -> {
    freedom { return exec_run(cmd) else -1 }
}

run_out(cmd<String>)<String> -> {
    freedom { return exec_output(cmd) else "" }
}

read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

write_flat(path<String>, content<String>)<Bool> -> {
    ok<Bool> = false
    match (open_write(path)) {
        w -> { n<Int> = write_str(w, content) else -1; close(w); ok = (n >= 0) }
        ? -> { ok = false }
    }
    return ok
}

parent_dir(p<String>)<String> -> {
    l<Int> = p.len()
    last<Int> = -1
    if (l > 0) {
        for (i in 0..l-1) { if (p.char_at(i) == 47) { last = i } }
    }
    if (last >= 0) { return p.substring(0, last) }
    return "/"
}

stage_file(stage<String>, e<FileEntry>)<Bool> -> {
    path<String> = stage + e.path
    par<String> = stage + parent_dir(e.path)
    if (run("mkdir -p \"" + par + "\"") != 0) { return false }
    ok<Bool> = false
    match (open_write(path)) {
        w -> { n<Int> = write_str(w, e.content) else -1; close(w); ok = (n >= 0) }
        ? -> { ok = false }
    }
    return ok
}

// deterministic synthesized source body for a pkg (reproducible offline)
body_of(name<String>, version<String>)<String> -> {
    return "bytes:" + name + ":" + version
}

// inline content_hash (vybos::content_hash is exactly this sha256 composition;
// inlined to avoid the splice/lookup quirk noted in the header).
chash(bytes<String>, name<String>, version<String>)<String> -> {
    return sha256(name + ":" + version + ":" + bytes)
}

// Artifact list for a resolved closure from the synthesized bytes.
// NOTE: no Pkg-typed local helpers — the toolchain's semantic pass fails to
// resolve `Pkg` inside a local helper's signature/body (splice-order quirk,
// file a repro); direct member access on spec.pkgs.get(i) works.
artifacts_of(spec<SystemSpec>, order<String>)<Vec<Artifact>> -> {
    out<Vec<Artifact>> = Vec()
    occ<Int> = order_count(order)
    if (occ > 0) {
        for (k in 0..occ-1) {
            nm<String> = token_kth(order, k)
            i<Int> = find_pkg(spec.pkgs, nm)
            if (i >= 0) {
                h<String> = chash(body_of(nm, spec.pkgs.get(i).version), nm,
                                         spec.pkgs.get(i).version)
                out.push(Artifact { name = nm, version = spec.pkgs.get(i).version, hash = h })
            }
        }
    }
    return out
}

// Generation-aware init that ALSO surfaces the verified state root the gate
// approved (the boot proof greps LEDGER_ROOT and compares it to want_root).
init_securegen()<String> -> {
    s<String> = "#!/bin/sh\n"
    s = s + "PATH=/bin:/usr/bin\n"
    s = s + "export PATH\n"
    s = s + "echo \"=== VybOS init (secure generation; ledger-verified closure) ===\"\n"
    s = s + "CUR=$(/bin/readlink /vyb/system/generations/current 2>/dev/null)\n"
    s = s + "[ -z \"$CUR\" ] && CUR=\"" + gen_dir(1) + "\"\n"
    s = s + "G=/vyb/system/generations/$CUR\n"
    s = s + "echo \"hostname: $(/bin/cat $G/etc/vyb-os/hostname 2>/dev/null)\"\n"
    s = s + "echo \"digest  : $(/bin/cat $G/etc/vyb-os/digest 2>/dev/null)\"\n"
    s = s + "echo \"LEDGER_ROOT=$(/bin/cat $G/etc/vyb-os/ledger-root 2>/dev/null)\"\n"
    s = s + "echo \"ACTIVE_GENERATION=$CUR\"\n"
    s = s + "echo \"VYBOS_READY=1\"\n"
    return s
}

main()<Int> -> {
    fails<Int> = 0
    seed1<String> = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    seed2<String> = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    regPub<String> = ed25519_publickey(seed1)
    bootPub<String> = ed25519_publickey(seed2)
    OUTD<String> = "build/securegen-out"
    BASE<String> = OUTD + "/root"
    storeDir<String> = "store"

    println("=== VybChain Phase 3: secure generation (verify-before-install -> boot) ===\n")

    // ---- COMPOSE + PLAN: a real module-composed system with a userspace pkg
    mods<Vec<Module>> = Vec()
    mods.push(sshd(true))
    mods.push(getty(true))
    s1<SystemSpec> = compose(blank_system("x86_64-linux", "generation-a"), mods)
    s1.pkgs.push(Pkg { name = "coreusers", version = "1.0", source = "http://mirror/coreusers",
                       deps = Vec(), storePath = "" })
    id1<Int> = spec_digest(s1)
    fails = fails + check(id1 > 0, "composed spec has a content digest")

    order<String> = resolve(s1.pkgs)
    arts<Vec<Artifact>> = artifacts_of(s1, order)
    want_root<String> = system_state_root(arts)
    fails = fails + check(arts.len() == order_count(order) && arts.len() > 0,
                          "closure resolved (" + order + ") -> artifacts bound")
    println("  gate target state root: " + want_root.substring(0, 16) + "...")

    // ---- VERIFY: publish the closure into the registry ledger, gate it
    sc<SignedChain> = registry_genesis("pkg", "ed25519", seed1)
    occ<Int> = order_count(order)
    if (occ > 0) {
        for (k in 0..occ-1) {
            nm<String> = token_kth(order, k)
            i<Int> = find_pkg(s1.pkgs, nm)
            h<String> = chash(body_of(nm, s1.pkgs.get(i).version), nm,
                                     s1.pkgs.get(i).version)
            sc = apply_op(sc, PkgOp { kind = "publish", name = nm,
                                      version = s1.pkgs.get(i).version,
                                      stage = "", hash = h }, seed1)
        }
    }
    ck<String> = sign_ledger_checkpoint(sc, seed1)
    gate<Bool> = verify_before_install(sc, arts, want_root, regPub, ck)
    fails = fails + check(gate, "§5 gate ok (closure approved for install)")

    // ---- REFUSE: a tampered artifact never reaches the builder
    evil<Vec<Artifact>> = Vec()
    evil.push(Artifact { name = "coreusers", version = "1.0", hash = "H_EVIL" })
    fails = fails + check(!verify_before_install(sc, evil, system_state_root(evil), regPub, ck),
                          "tampered artifact REFUSED by the gate (nothing staged)")
    fails = fails + check(run("test ! -e \"" + BASE + "\" || rm -rf \"" + BASE + "\"") == 0,
                          "builder tree absent until the gate approves")

    // ---- RECORD: full §2 package record for the installed system
    rec<ModuleRecord> = ModuleRecord {
        name = "system", version = "0.1", target = "x86_64-linux", namespace = "vybos",
        upstreamRepo = "http://mirror", upstreamRevision = "tip",
        pristineHash = "h_pristine", closure = order,
        toolchain = "Vyb 0.7.7", buildFlags = "-O2", builderId = "nyc-1",
        validation = "securegen", artifactHash = want_root,
        publisherSeed = seed1, timestamp = "2026-10-26T00:00:00Z",
        patches = Vec()
    }
    rroot<String> = record_root(rec)
    rec_chain<SignedChain> = seal_module_record(rec, "vybforge/pkg-records", seed1)
    fails = fails + check(is_legit_record(rec_chain, rroot, regPub),
                          "installed-system package record authentic (publisher-signed)")

    // ---- BUILD: stage the generation tree (gate-approved root baked in)
    if (run("mkdir -p \"" + BASE + "/etc\" \"" + BASE + "/vyb/system/generations\"") != 0) {
        println("  FAIL fresh staging"); return 1
    }
    if (!write_flat(OUTD + "/init", init_securegen())) { println("  FAIL write init"); return 1 }
    if (!stage_file(BASE, FileEntry { path = "/init", content = init_securegen() })) { fails = fails + 1 }
    gs<Vec<FileEntry>> = gen_entries(id1, s1)
    gn<Int> = gs.len()
    if (gn > 0) {
        for (i in 0..gn-1) { if (!stage_file(BASE, gs.get(i))) { fails = fails + 1 } }
    }
    // the verified state root rides INSIDE the generation's config tree
    if (!stage_file(BASE, FileEntry {
            path = "/vyb/system/generations/" + gen_dir(id1) + "/etc/vyb-os/ledger-root",
            content = want_root + "\n" })) { fails = fails + 1 }
    fails = fails + check(run("ln -sfn \"" + etc_link_target() + "\" \"" + BASE + "/etc/vyb-os\"") == 0,
                          "/etc/vyb-os -> active generation link")
    // seed the userspace binary (stand-in busybox until the derived-busybox step).
    // The relink loop is REQUIRED: busybox --install -s creates applet symlinks
    // pointing at the HOST's absolute busybox path, which does not exist in the
    // guest (kernel execve of /init then fails with ENOENT on #!/bin/sh).
    seedCmd<String> = "B=\"" + BASE + "\" && mkdir -p \"$B/bin\" \"$B/dev\" && " +
        "cp /usr/bin/busybox \"$B/bin/busybox\" && chmod +x \"$B/bin/busybox\" && " +
        "\"$B/bin/busybox\" --install -s \"$B/bin\" >/dev/null 2>&1; " +
        "for f in \"$B\"/bin/*; do [ \"$(basename \"$f\")\" = busybox ] || ln -sf busybox \"$f\"; done; " +
        "rm -f \"$B/bin/relink_probe\""
    fails = fails + check(run(seedCmd) == 0, "seed /bin (stand-in busybox, relative applet links)")
    fails = fails + check(read_flat(BASE + "/vyb/system/generations/" + gen_dir(id1) +
                          "/etc/vyb-os/ledger-root").len() == 65,
                          "ledger-root baked into the generation tree")

    // ---- image variant: current -> gen-1, ext4, content-addressed
    imgPath<String> = OUTD + "/securegen-gen1.img"
    tdir<String> = BASE + "-v1"
    imgCmd<String> = "T=\"" + tdir + "\" && rm -rf \"$T\" && cp -a \"" + BASE + "/.\" \"$T/\" && " +
        "chmod +x \"$T/init\" && " +
        "ln -sfn \"" + gen_dir(id1) + "\" \"$T/vyb/system/generations/current\" && " +
        "rm -f \"" + imgPath + "\" && " +
        "mke2fs -q -d \"$T\" -F -t ext4 -b 4096 -L vybos-securegen \"" + imgPath + "\" 16384 && " +
        "sha256sum \"" + imgPath + "\" > \"" + imgPath + ".sha\""
    fails = fails + check(run(imgCmd) == 0, "secure generation image built (ext4)")
    shaTxt<String> = read_flat(imgPath + ".sha")
    imgSha<String> = ""
    if (shaTxt.len() >= 64) { imgSha = shaTxt.substring(0, 64) }
    fails = fails + check(imgSha.len() == 64, "image content-address captured (sha256)")

    // ---- LEGIT: signed boot-legitimization over (gen, kernel id, image, state root)
    kout<String> = run_out("find " + storeDir + " -name linux-6.6-bzImage.bin | head -1")
    kernelId<String> = ""
    kpath<String> = ""
    kl<Int> = kout.len()
    if (kl > 0) {
        kpath = kout
        if (kout.char_at(kl-1) == 10) { kpath = kout.substring(0, kl-1) }
        last<Int> = -1
        for (i in 0..kpath.len()-1) { if (kpath.char_at(i) == 47) { last = i } }
        if (last > 0) { kernelId = kpath.substring(0, last) }
        seg<Int> = -1
        for (i in 0..kernelId.len()-1) { if (kernelId.char_at(i) == 47) { seg = i } }
        if (seg >= 0) { kernelId = kernelId.substring(seg+1, kernelId.len()) }
    }
    fails = fails + check(kernelId.len() == 64, "derived kernel store id located")
    boot<SignedChain> = seal_boot_signed(gen_dir(id1), kernelId, imgSha, want_root, seed2)
    fails = fails + check(is_legit_signed(boot, bootPub), "boot legitimization authentic (signed)")
    fails = fails + check(write_flat(OUTD + "/boot-legit.receipt", serialize(boot.chain)),
                          "boot receipt persisted")
    // disk round-trip: re-read, re-parse, integrity + authenticity via the
    // registry checkpoint (tip, seq) signed by the boot issuer
    rt<String> = read_flat(OUTD + "/boot-legit.receipt")
    back<Chain> = deserialize(rt)
    fails = fails + check(verify(back), "receipt re-verifies after disk round-trip")
    bootCk<String> = sign_boot_checkpoint(boot, seed2)
    fails = fails + check(verify_boot_checkpoint(tip_hash(back), back.blocks.len(), bootPub, bootCk),
                          "receipt authenticity re-established (checkpoint over tip)")
    // tamper: flip a byte in the persisted receipt -> caught
    evilRt<String> = rt
    if (evilRt.len() > 40) {
        flip<String> = "1"
        if (evilRt.char_at(20) == 49) { flip = "0" }
        evilRt = evilRt.substring(0, 20) + flip + evilRt.substring(21, evilRt.len())
    }
    evilC<Chain> = deserialize(evilRt)
    // the flip lands in block content, so integrity verify must fail (and the
    // checkpoint over the altered bytes must not re-establish authenticity)
    fails = fails + check(!verify(evilC),
                          "tampered receipt caught (integrity verify fails)")

    // ---- boot contract (checked by the harness after this slice):
    //   ./tools/vybos-run --runtime qemu --disk <img> --test
    //   console must print LEDGER_ROOT == want_root and ACTIVE_GENERATION.
    println("\n  image        : " + imgPath)
    println("  LEDGER_ROOT  : " + want_root)
    println("  ACTIVE_GEN   : " + gen_dir(id1))
    println("  boot proof   : tools/vybos-run --runtime qemu --disk " + imgPath + " --test")

    println("")
    sum<String> = "ALL SECURE-GEN (VYBCHAIN PHASE 3) INVARIANTS PASS"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println(sum)
    if (fails == 0) { return 0 }
    return 1
}
