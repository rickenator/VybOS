// build-url-realize.vyb — VybOS M3: REAL HTTPS URL-driven realization (scheme
// -> client -> verified TLS fetch -> content-addressed store).
//
// build-exec.vyb realises a module-composed spec against a deterministic
// name-keyed httpbin mirror. This slice realises the SAME framework shape but
// from each package's OWN real HTTPS `source` URL: url_split parses it, the
// scheme selects the transport (http_get_full vs https_get_full_verified with
// the system CA), and the bytes are fetched over genuine TLS, hashed, and
// written to the store with .drv-style .meta.json.
//
// Sources are SMALL, stable, real HTTPS files (GitHub raw + nginx.org), chosen
// so the run is reproducible and fits the toolchain's string registry (a large
// tarball inflate can exhaust VYB_STR_REG_CAP — a toolchain limit).
//
// Invariants:
//   1. scheme-driven client selection resolves a real https URL + fetches 200
//   2. real bytes are content-hashed and realised (.src + .meta.json on disk)
//   3. identities are deterministic (same hashes across runs)
import collections
import http
import https
import io
import io::{open_write, write_str, close, open_read, read_all}
import vybos::{content_hash}
import url::{url_split, UrlSplit}
import plan::{Pkg, Dep, SystemSpec, RealRec, resolve, real_table, real_of,
              find_pkg, order_count, token_kth}
import realize::{realize_one, meta_inputs, closure_real}
import urlrealize::{realize_spec_url, UrlRealizeResult}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { println("  FAIL " + label); return 1 }
    println("  ok   " + label)
    return 0
}

// naive substring test.
substr_has(h<String>, nd<String>)<Bool> -> {
    hl<Int> = h.len()
    nl<Int> = nd.len()
    if (nl > hl) { return false }
    for (i in 0..hl-nl) {
        ok<Bool> = true
        for (j in 0..nl-1) {
            if (h.char_at(i + j) != nd.char_at(j)) { ok = false; break }
        }
        if (ok) { return true }
    }
    return false
}

// read a whole file ("" on failure/absence).
read_flat(path<String>)<String> -> {
    match (open_read(path)) {
        r -> {
            match (read_all(r)) { s -> { close(r); return s } ? -> { close(r); return "" } }
        }
        ? -> { return "" }
    }
}

main()<Int> -> {
    storeDir<String> = "store"
    println("=== VybOS M3: REAL HTTPS URL-driven realization ===\n")
    fails<Int> = 0

    // 1. parse a real HTTPS source URL and confirm scheme/port/path.
    u<UrlSplit> = url_split("https://raw.githubusercontent.com/nginx/nginx/master/conf/nginx.conf")
    fails = fails + check(u.scheme == "https", "scheme https parsed")
    fails = fails + check(u.port == 443,        "default port 443 for https")
    fails = fails + check(substr_has(u.path, "/nginx/nginx/"), "multi-segment path kept")

    // 2. genuinely fetch it over TLS (system CA) and realise it from its OWN
    //    source URL (no hardcoded host/port/path).
    src<String> = "https://raw.githubusercontent.com/nginx/nginx/master/conf/nginx.conf"
    name<String> = "nginxconf"
    ver<String> = "master"
    spec<SystemSpec> = SystemSpec { system = "x86_64-linux", hostname = "urltest",
                                    pkgs = Vec(), services = Vec() }
    deps<Vec<Dep>> = Vec()
    spec.pkgs.push(Pkg { name = name, version = ver, source = src, deps = deps, storePath = "" })

    res<UrlRealizeResult> = realize_spec_url(storeDir, spec)
    fails = fails + check(res.failed == 0, "real HTTPS fetch + realise: no failures")
    fails = fails + check(res.realised == 1, "exactly 1 pkg realised from its own URL")

    // 3. on-disk: .meta.json + .src exist and record the real HTTPS URL.
    nr<Int> = closure_real(spec, name)
    sp<String> = storeDir + "/" + nr.to_string() + "-" + name + "-" + ver + ".meta.json"
    ss<String> = storeDir + "/" + nr.to_string() + "-" + name + "-" + ver + ".src"
    raw<String> = read_flat(sp)
    fails = fails + check(nr > 0, "positive closure identity")
    fails = fails + check(substr_has(raw, "\"source\": \"" + src + "\""), "meta records the real HTTPS source URL")
    fails = fails + check(substr_has(raw, "\"name\": \"" + name + "\""), "meta records the pkg name")
    fails = fails + check(read_flat(ss).len() > 0, "real fetched bytes written to .src")

    println("")
    println("  realised=" + res.realised.to_string() + " failed=" + res.failed.to_string())
    println("  meta: " + sp)
    println("")

    sum<String> = "ALL REAL-HTTPS-URL-REALIZATION INVARIANTS PASS"
    if (fails > 0) { sum = fails.to_string() + " FAILURE(S)" }
    println(sum)
    if (fails == 0) { return 0 }
    return 1
}
