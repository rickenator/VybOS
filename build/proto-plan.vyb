import collections
import plan::{Dep, Pkg, Service, SystemSpec, RealRec, Generation,
              find_pkg, order_count, token_kth, token_has, dep_key,
              realize_hash, leaf_key, kinds_valid, parent_id}

// ---- derivation: build a Pkg with a FRESH internal deps Vec (move-safe) ----
deriv(name<String>, ver<String>, src<String>, depNames<Vec<String>>)<Pkg> -> {
    deps<Vec<Dep>> = Vec()
    m<Int> = depNames.len()
    if (m > 0) {
        for (k in 0..m-1) { deps.push(Dep { name = depNames.get(k), kind = "runtime" }) }
    }
    h<Int> = realize_hash(name, ver, src, dep_key(deps))
    return Pkg { name = name, version = ver, source = src, deps = deps,
                 storePath = "/vyb/store/" + h.to_string() + "-" + name + "-" + ver }
}

// ---- resolve: dependency-first topological order, for-over-passes (stable) ----
resolve(g<Vec<Pkg>>)<String> -> {
    n<Int> = g.len()
    if (n == 0) { return "" }
    ps<String> = ""
    order<String> = ""
    for (pp in 0..n-1) {
        chosen<Int> = -1
        for (i in 0..n-1) {
            if (token_has(ps, g.get(i).name)) { continue }
            dblock<Bool> = false
            dm<Int> = g.get(i).deps.len()
            if (dm > 0) {
                for (k in 0..dm-1) {
                    if (!token_has(ps, g.get(i).deps.get(k).name)) { dblock = true; break }
                }
            }
            if (!dblock) { chosen = i; break }
        }
        if (chosen < 0) { return "cycle" }
        if (ps.len() > 0) { ps = ps + "," }
        ps = ps + g.get(chosen).name
        if (order.len() > 0) { order = order + "," }
        order = order + g.get(chosen).name
    }
    return order
}

// ---- validation: unknown dep or cycle -> non-empty message ----
resolve_issue(g<Vec<Pkg>>)<String> -> {
    n<Int> = g.len()
    if (n > 0) {
        for (i in 0..n-1) {
            dm<Int> = g.get(i).deps.len()
            if (dm > 0) {
                for (k in 0..dm-1) {
                    if (find_pkg(g, g.get(i).deps.get(k).name) < 0) {
                        return "unknown dep: " + g.get(i).deps.get(k).name + " (wanted by " + g.get(i).name + ")"
                    }
                }
            }
        }
    }
    if (resolve(g) == "cycle") { return "dependency cycle detected" }
    return ""
}

// ---- realization record lookup ----
real_of(recs<Vec<RealRec>>, name<String>)<Int> -> {
    n<Int> = recs.len()
    if (n > 0) {
        for (i in 0..n-1) { if (recs.get(i).name == name) { return recs.get(i).real } }
    }
    return 0
}

// ---- closure-aware realization table (deps-first, includes dep reals) ----
real_table(g<Vec<Pkg>>)<Vec<RealRec>> -> {
    order<String> = resolve(g)
    occ<Int> = order_count(order)
    recs<Vec<RealRec>> = Vec()
    if (occ > 0) {
        for (k in 0..occ-1) {
            nm<String> = token_kth(order, k)
            i<Int> = find_pkg(g, nm)
            deps<Vec<Dep>> = g.get(i).deps
            ds<String> = ""
            dm<Int> = deps.len()
            if (dm > 0) {
                for (q in 0..dm-1) {
                    dk<Dep> = deps.get(q)
                    pr<Int> = 0
                    if (find_pkg(g, dk.name) >= 0) { pr = real_of(recs, dk.name) }
                    ds = ds + dk.name + "=" + pr.to_string() + ";"
                }
            }
            preal<Int> = realize_hash(g.get(i).name, g.get(i).version, g.get(i).source, dep_key(deps) + "|" + ds)
            recs.push(RealRec { name = g.get(i).name, real = preal })
        }
    }
    return recs
}

// ---- whole-system closure-sensitive digest (generation identity) ----
spec_digest(spec<SystemSpec>)<Int> -> {
    recs<Vec<RealRec>> = real_table(spec.pkgs)
    n<Int> = recs.len()
    acc<Int> = 2166136261
    if (n > 0) {
        for (i in 0..n-1) { acc = (acc * 16777619) ^ recs.get(i).real }
    }
    return acc
}

// ---- transition plan as text lines (closure-aware; empty cur = fresh) ----
plan_lines(cur<SystemSpec>, des<SystemSpec>)<String> -> {
    out<String> = ""
    desG<Vec<Pkg>> = des.pkgs
    curG<Vec<Pkg>> = cur.pkgs
    nc<Int> = curG.len()
    if (nc == 0) {
        nd<Int> = desG.len()
        if (nd > 0) {
            for (i in 0..nd-1) { out = out + "install " + desG.get(i).name + "\n" }
        }
    } else {
        bcur<Vec<RealRec>> = real_table(curG)
        bdes<Vec<RealRec>> = real_table(desG)
        nd<Int> = desG.len()
        if (nd > 0) {
            for (i in 0..nd-1) {
                dj<Int> = find_pkg(curG, desG.get(i).name)
                if (dj < 0) {
                    out = out + "install " + desG.get(i).name + "\n"
                } else {
                    if (real_of(bcur, desG.get(i).name) != real_of(bdes, desG.get(i).name)) {
                        out = out + "rebuild " + desG.get(i).name + "\n"
                    } else {
                        out = out + "keep " + desG.get(i).name + "\n"
                    }
                }
            }
        }
        nc2<Int> = curG.len()
        if (nc2 > 0) {
            for (i in 0..nc2-1) {
                if (find_pkg(desG, curG.get(i).name) < 0) { out = out + "remove " + curG.get(i).name + "\n" }
            }
        }
    }
    return out
}

// token index for order-checking, or -1.
tokidx(ord<String>, name<String>)<Int> -> {
    c<Int> = order_count(ord)
    if (c > 0) {
        for (i in 0..c-1) { if (token_kth(ord, i) == name) { return i } }
    }
    return -1
}

// naive substring test (module String has no visible .n on this build).
substr_has(h<String>, nd<String>)<Bool> -> {
    hl<Int> = h.len()
    nl<Int> = nd.len()
    if (nl > hl) { return false }
    for (i in 0..hl-nl) {
        ok<Bool> = true
        for (j in 0..nl-1) {
            if (h.char_at(i + j) != nd.char_at(j)) { ok = false; break }
        }
        if (ok) { return true }
    }
    return false
}

check(cond<Bool>, label<String>)<Int> -> {
    if (!cond) { print("  FAIL " + label + "\n"); return 1 }
    print("  ok   " + label + "\n")
    return 0
}

main()<Int> -> {
    print("VybOS panel prototype (pure Vyb, no host mutation)\n")

    libNames<Vec<String>> = Vec()
    libNames.push("zlib")
    noNames<Vec<String>> = Vec()

    // Config A: gzip 1.0 (runtime dep zlib), zlib, vyb; ssh enabled
    a<SystemSpec> = SystemSpec { system = "x86_64-linux", hostname = "hera-a", pkgs = Vec(), services = Vec() }
    a.pkgs.push(deriv("gzip", "1.0", "gz1.tar.gz", libNames))
    a.pkgs.push(deriv("zlib", "1.3", "z.tar.gz", noNames))
    a.pkgs.push(deriv("vyb", "0", "vyb.tar.gz", noNames))
    a.services.push(Service { name = "ssh", command = "sshd", enabled = true })

    // Config B: gzip 2.0, zlib, openssl (dep zlib), vyb; ssh disabled
    b<SystemSpec> = SystemSpec { system = "x86_64-linux", hostname = "hera-b", pkgs = Vec(), services = Vec() }
    b.pkgs.push(deriv("gzip", "2.0", "gz2.tar.gz", libNames))
    b.pkgs.push(deriv("zlib", "1.3", "z.tar.gz", noNames))
    b.pkgs.push(deriv("openssl", "3.1", "os.tar.gz", libNames))
    b.pkgs.push(deriv("vyb", "0", "vyb.tar.gz", noNames))
    b.services.push(Service { name = "ssh", command = "sshd", enabled = false })

    // Config C: only zlib ticked 1.3 -> 1.4
    cSpec<SystemSpec> = SystemSpec { system = "x86_64-linux", hostname = "hera-c", pkgs = Vec(), services = Vec() }
    cSpec.pkgs.push(deriv("gzip", "2.0", "gz2.tar.gz", libNames))
    cSpec.pkgs.push(deriv("zlib", "1.4", "z.tar.gz", noNames))
    cSpec.pkgs.push(deriv("openssl", "3.1", "os.tar.gz", libNames))
    cSpec.pkgs.push(deriv("vyb", "0", "vyb.tar.gz", noNames))
    cSpec.services.push(Service { name = "ssh", command = "sshd", enabled = false })

    // B2: identical packages, different hostname (prose/metadata NOT part of identity)
    b2<SystemSpec> = SystemSpec { system = "x86_64-linux", hostname = "anything-else", pkgs = Vec(), services = Vec() }
    b2.pkgs.push(deriv("gzip", "2.0", "gz2.tar.gz", libNames))
    b2.pkgs.push(deriv("zlib", "1.3", "z.tar.gz", noNames))
    b2.pkgs.push(deriv("openssl", "3.1", "os.tar.gz", libNames))
    b2.pkgs.push(deriv("vyb", "0", "vyb.tar.gz", noNames))
    b2.services.push(Service { name = "ssh", command = "sshd", enabled = false })

    empty<SystemSpec> = SystemSpec { system = "", hostname = "", pkgs = Vec(), services = Vec() }

    an<Vec<String>> = Vec(); an.push("beta")
    bn<Vec<String>> = Vec(); bn.push("alpha")
    cyc<SystemSpec> = SystemSpec { system = "", hostname = "c", pkgs = Vec(), services = Vec() }
    cyc.pkgs.push(deriv("alpha", "1", "a.tar.gz", an))
    cyc.pkgs.push(deriv("beta", "1", "b.tar.gz", bn))

    gn<Vec<String>> = Vec(); gn.push("ghost")
    ux<SystemSpec> = SystemSpec { system = "", hostname = "u", pkgs = Vec(), services = Vec() }
    ux.pkgs.push(deriv("x", "1", "x.tar.gz", gn))

    fails<Int> = 0

    print("== validation ==\n")
    fails = fails + check(resolve_issue(a.pkgs) == "", "Config A resolves cleanly")
    fails = fails + check(resolve_issue(b.pkgs) == "", "Config B resolves cleanly")
    fails = fails + check(resolve_issue(cyc.pkgs) != "", "cycle is rejected before activation")
    fails = fails + check(resolve_issue(ux.pkgs) != "", "unknown dep is rejected before activation")
    fails = fails + check(kinds_valid(b.pkgs), "all dependency kinds recognised")

    print("== resolver: dependency-first order ==\n")
    ob<String> = resolve(b.pkgs)
    print("   order: " + ob + "\n")
    fails = fails + check(tokidx(ob, "zlib") < tokidx(ob, "gzip"), "zlib built before gzip")
    fails = fails + check(tokidx(ob, "zlib") < tokidx(ob, "openssl"), "zlib built before openssl")
    fails = fails + check(tokidx(ob, "vyb") >= 0, "vyb present in order")

    print("== deterministic, closure-sensitive digest ==\n")
    d1<Int> = spec_digest(b)
    d2<Int> = spec_digest(b)
    fails = fails + check(d1 == d2, "same spec -> same digest (determinism)")
    fails = fails + check(spec_digest(a) != d1, "gzip 1.0 vs 2.0 -> different digest")
    fails = fails + check(spec_digest(b2) == d1, "hostname-only change -> same digest (prose independence)")

    print("== incremental transition plans ==\n")
    pf<String> = plan_lines(empty, a)
    print("-- fresh:\n" + pf)
    pa<String> = plan_lines(a, b)
    print("-- A -> B:\n" + pa)
    fails = fails + check(substr_has(pa, "install openssl"), "A->B installs openssl")
    fails = fails + check(substr_has(pa, "rebuild gzip"), "A->B rebuilds gzip (version bump)")
    fails = fails + check(substr_has(pa, "keep vyb"), "A->B leaves vyb untouched")
    fails = fails + check(!substr_has(pa, "remove "), "A->B removes nothing")

    pb<String> = plan_lines(b, cSpec)
    print("-- B -> C (zlib 1.3 -> 1.4):\n" + pb)
    fails = fails + check(substr_has(pb, "rebuild zlib"), "zlib change rebuilds zlib")
    fails = fails + check(substr_has(pb, "rebuild gzip"), "transitive: gzip closure rebuilt")
    fails = fails + check(substr_has(pb, "rebuild openssl"), "transitive: openssl closure rebuilt")
    fails = fails + check(substr_has(pb, "keep vyb"), "unrelated vyb untouched")
    fails = fails + check(plan_lines(a, b) == pa, "plan is deterministic")

    print("== generations & rollback ==\n")
    g1<Generation> = Generation { id = 1, parent = Int?(), hash = spec_digest(a) }
    g2<Generation> = Generation { id = 2, parent = Int?(1), hash = spec_digest(b) }
    fails = fails + check(g1.id == 1 && parent_id(g1) == 0, "gen1 is root")
    fails = fails + check(g2.id == 2 && parent_id(g2) == 1, "gen2 parented on gen1 (rollback target)")
    fails = fails + check(g2.hash != g1.hash, "gen2 has different content digest")

    print("== serialization (config as JSON for MCP) ==\n")
    jb<String> = b.to_string()
    print("   " + jb + "\n")
    fails = fails + check(jb.len() > 0 && substr_has(jb, "openssl"), "SystemSpec serializes to JSON")

    sumline<String> = ""
    if (fails == 0) { sumline = "ALL INVARIANTS PASS" } else { sumline = fails.to_string() + " FAILURE(S)" }
    print("\n" + sumline + "\n")
    if (fails == 0) { return 0 }
    return 1
}

