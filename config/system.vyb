// system.vyb — a concrete machine declaration for VybOS, built by MODULE
// COMPOSITION (modules/compose.vyb). This is the config-as-program proof at
// the module level: evaluating this program under the Vyb JIT yields a full
// SystemSpec, assembled by folding typed module contributions instead of a
// bespoke config DSL.
//
// The convention (doc/COMPOSITION.md): each `modules/*.vyb` exports a
// function taking its OWN options and returning a Module contribution;
// `compose()` folds them into the SystemSpec. Toggling a module on/off here
// is a one-line change (true -> false). machine-valid output goes through
// spec.to_string() (Vyb's clean nested JSON), not main() auto-serialization.

import collections
import compose::{Module, blank_system, compose, compose_issue}
import plan::{SystemSpec, Pkg, Service}
import sshd::{sshd}
import getty::{getty}
import vim::{vim}

main()<Int> -> {
    // Declare which modules this machine runs and with what options.
    mods<Vec<Module>> = Vec()
    mods.push(sshd(true))       // OpenSSH server
    mods.push(getty(true))      // serial console on tty1
    mods.push(vim(true))        // vim editor (package only)

    base<SystemSpec> = blank_system("x86_64-linux", "vybos-test")
    spec<SystemSpec> = compose(base, mods)

    // Any non-empty issue means the merged system is invalid — abort before
    // it could ever be realised. This mirrors the realizer's pre-flight gate.
    issue<String> = compose_issue(spec)
    println("=== VybOS SystemSpec (module-composed, JIT-evaluated) ===")
    println("system: " + spec.system)
    println("hostname: " + spec.hostname)
    println("validate: " + if (issue == "") { "clean" } else { "ISSUE: " + issue })

    println("packages (" + spec.pkgs.len().to_string() + "):")
    pkgs<Vec<Pkg>> = spec.pkgs
    for (p in pkgs) {
        println("  " + p.name + " " + p.version + "  ->  " + p.storePath)
    }

    println("services (" + spec.services.len().to_string() + "):")
    svcs<Vec<Service>> = spec.services
    for (s in svcs) {
        line<String> = "  [" + s.enabled.to_string() + "] " + s.name + " :: " + s.command
        if (s.port > 0) { line = line + "  (port " + s.port.to_string() + ")" }
        ak<Int> = s.args.len()
        if (ak > 0) {
            al<String> = "  (args "
            for (i in 0..ak-1) { if (i > 0) { al = al + " " }; al = al + s.args.get(i) }
            line = line + al + ")"
        }
        println(line)
    }

    println("")
    println("--- SystemSpec JSON (machine contract) ---")
    println(spec.to_string())

    if (issue != "") { return 1 }
    return 0
}
