// packagerealization.vyb — VybOS PACKAGE REALIZATION RECORD (issue #7).
//
// Seals the ACCEPTED, state-tagged patch set into an AUTHENTIC signed
// realization record — the provenance that lets a rebuild apply the exact
// stored patches instead of re-running inference. Where modules/packagerecord
// seals a §2 package record (patches carry class + hash + generator), THIS
// module adds per-patch LIFECYCLE STATE + REASON (from modules/patchlife) and
// enforces at seal time that the recorded state is LEGAL for its class — you
// cannot seal an illegal/high-risk-unapproved patch into an accepted
// realization. The pattern fulfils #7:
//
//   "AI may author a repair, but VybForge owns, validates, hashes, records,
//    reproduces, and promotes the patch."
//
// Once accepted, the patch is part of the realization record (id, class,
// content hash, lifecycle state, reason, generator provenance) with a
// deterministic realization root = sha256 over the sorted patch identity — so
// rebuilding reproduces the exact accepted-validated patch set. Payload bytes
// stay in the content-addressed store; this seals identity, state, and trust.
//
// The module NEVER embeds key material — seeds are caller-supplied.
//
// Run-free library (no main); proven by build/build-packagerealization.vyb.

import collections
import chain::{signed_genesis, signed_append, signed_verify, contains, tip_hash,
             Record, SignedChain}
import crypto::{sha256}
import patchlife::{ManagedPatch, is_patch_state, is_patch_class, initial_state, promotable}

// A patch as it appears in an ACCEPTED realization record: its immutable
// identity + class + content hash, its lifecycle state + reason, and (for
// generated) the generator origin.
share(all)
struct RealPatch {
    id<String>,
    hash<String>,        // content hash of the patch bytes
    cls<String>,         // upstream | curated | generated
    state<String>,       // lifecycle state (must be legal for cls)
    reason<String>,      // the repair objective (generated; else "")
    generator<String>    // model/generator identity (generated; else "")
}

// Convert a managed (lifecycle-owned) patch into a realization record patch,
// ADOPTING its current lifecycle state. Only legal states pass (guarded by the
// caller's is_legally_sealable check); state/reason/generator ride along.
share(all)
to_real_patch(p<ManagedPatch>, hash<String>)<RealPatch> -> {
    return RealPatch { id = p.id, hash = hash, cls = p.cls, state = p.state,
                       reason = p.reason, generator = p.generator }
}

// A patch is legally sealable into an ACCEPTED realization only if its state is
// (a) a recognized lifecycle state, (b) legal as an initial/current state for
// its class, and (c) promotable-compatible — i.e. not an illegal state like a
// high-risk patch stuck pre-review while claiming reviewed. In practice: an
// accepted realization carries patches that have reached a promotable,
// class-consistent state (e.g. a generated patch must have been at least
// reviewed to be part of an accepted realization).
share(all)
is_legally_sealable(p<RealPatch>)<Bool> -> {
    if (!is_patch_class(p.cls)) { return false }
    if (!is_patch_state(p.state)) { return false }
    # a patch in its initial state is not yet validated action; an accepted
    # realization requires it to have passed its review gate (so rebuilding
    # applies a vetted patch, not an unreviewed authoring attempt).
    if (p.cls == "generated" && p.state == "experimental") { return false }
    if (p.cls == "generated" && p.state == "validated-candidate") { return false }
    # upstream/curated already start reviewed/submitted -> fine.
    return true
}

// Deterministic realization root: sha256 over the SORTED accepted patch
// identity (id|hash|cls|state). Order-independent so the same accepted patch
// set seals to the same root regardless of enumeration order.
share(all)
realization_identity(patches<Vec<RealPatch>>)<String> -> {
    lines<Vec<String>> = Vec()
    n<Int> = patches.len()
    if (n > 0) {
        for (i in 0..n - 1) {
            p<RealPatch> = patches.get(i)
            lines.push(p.id + "|" + p.hash + "|" + p.cls + "|" + p.state)
        }
    }
    sl<Vec<String>> = lines.sorted()
    s<String> = ""
    m<Int> = sl.len()
    if (m > 0) {
        for (i in 0..m - 1) {
            if (i > 0) { s = s + "; " }
            s = s + sl.get(i)
        }
    }
    return sha256(s)
}

// Seal an ACCEPTED package realization: genesis = package/upstream identity +
// the deterministic realization identity (so the state-tagged patch set is a
// single verifiable hash), then one signed block per accepted patch (records
// bind class/state/reason/generator — signed_verify detects any tamper).
// Returns the SignedChain. The caller MUST pass only is_legally_sealable
// patches (accepted realization = every patch has passed its review gate).
share(all)
seal_realization(rec_name<String>, rec_version<String>, upstream<String>,
                 ident<String>, patches<Vec<RealPatch>>,
                 origin<String>, seed<String>)<SignedChain> -> {
    facts<Vec<Record>> = Vec()
    facts.push(Record { label = "realization", value = rec_name + "@" + rec_version })
    facts.push(Record { label = "upstream", value = upstream })
    facts.push(Record { label = "realization_identity", value = ident })
    base<SignedChain> = signed_genesis(origin, facts, seed)
    n2<Int> = patches.len()
    for (i in 0..n2 - 1) {
        p<RealPatch> = patches.get(i)
        val<String> = p.hash + "|" + p.cls + "|" + p.state
        if (p.cls == "generated" && p.reason.len() > 0) { val = val + "|reason:" + p.reason }
        if (p.cls == "generated" && p.generator.len() > 0) { val = val + "|gen:" + p.generator }
        base = signed_append(base, one_record(p, val), seed, seed)
    }
    return base
}

# one-record block carrying a patch's state-tagged provenance
share(all)
one_record(p<RealPatch>, val<String>)<Vec<Record>> -> {
    r<Vec<Record>> = Vec()
    r.push(Record { label = "patch:" + p.id, value = val })
    return r
}

# True iff the realization is AUTHENTIC (signed_verify under the forge pubkey as
# the trust root) AND it records exactly `expected` as its realization_identity.
share(all)
is_legit_realization(sc<SignedChain>, expected<String>, forge_pub<String>)<Bool> -> {
    if (!signed_verify(sc, forge_pub)) { return false }
    return contains(sc.chain, "realization_identity", expected)
}
