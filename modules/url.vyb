// url.vyb — VybOS framework: URL parsing (pure Vyb, no FFI).
//
// SCOPE: gives the realizer a single `url` String to drive fetch, instead of
// hardcoding (host, port, path) at every call site. A URL is split into
// (scheme, host, port, path) with the scheme's conventional default port
// resolved when absent, so the build framework can pick the http vs https
// client from the scheme and pass port/path straight through.
//
// This is the framework-side companion to doc/RFE-M2.md Item 4 (a stdlib
// `url` module is an implementation-agent RFE; VybOS carries its own so the
// realizer does not wait on the toolchain, per AGENTS.md "actions are yours").
//
// Not to NixOS: the port-resolved authority + default port mirrors how a
// client selects transporter — the "which port do I dial by default" knowledge
// lives in one declarative place (default_port via select) instead of a chain
// of starts_with checks.
//
// NOTE: Vyb ranges are INCLUSIVE of the upper bound; iterate with 0..len-1 and
// guard empties, or you read one-past-the-buffer (double-free).

// The four components of a parsed absolute URL, with `port` always resolved to
// a concrete number (the scheme default when the URL omits one).
share(all)
struct UrlSplit {
    scheme<String>,
    host<String>,
    port<Int>,
    path<String>
}

// The conventional default port for a scheme name, classified with a
// single-value String `select`. Unknown / empty schemes fall to the wildcard.
share(all)
default_port(scheme<String>)<Int> -> {
    return select(scheme) -> {
        "https" -> 443,
        "http"  -> 80,
        ?       -> 0
    }
}

// Parse a base-10 integer out of a decimal digit string ("\u{0}" on no digits).
share(all)
str_to_int(s<String>)<Int> -> {
    n<Int> = 0
    l<Int> = s.len()
    if (l > 0) {
        for (i in 0..l-1) {
            c<Int> = s.char_at(i)
            if (c >= 48 && c <= 57) { n = n * 10 + (c - 48) }
        }
    }
    return n
}

// Split a raw absolute URL string into its components, resolving the default
// port. A leading scheme (`scheme://`) is honoured; a bare host/port or
// host:path input defaults the scheme to "http". This is the VybOS `derive`
// entry: take one string, get a concrete (scheme, host, port, path) to fetch.
// BUILD-WIDE INFERENCE: a string with no scheme and no authority (`hello`) is
// treated as a host-only reference, matching the demo parser's parse_url.
share(all)
url_split(raw<String>)<UrlSplit> -> {
    s<String> = raw.trim()
    scheme<String> = "http"
    rest<String> = s
    mark<Int> = s.index_of("://")
    if (mark >= 0) {
        scheme = s.substring(0, mark).to_lower()
        rest = s.substring(mark + 3, s.len())
    }
    port<Int> = default_port(scheme)
    path<String> = "/"
    hostport<String> = rest
    slash<Int> = rest.index_of("/")
    if (slash >= 0) {
        hostport = rest.substring(0, slash)
        path = rest.substring(slash, rest.len())
        if (path == "") { path = "/" }
    }
    host<String> = hostport
    colon<Int> = hostport.index_of(":")
    if (colon >= 0) {
        host = hostport.substring(0, colon)
        ps<String> = hostport.substring(colon + 1, hostport.len())
        if (ps.len() > 0) { port = str_to_int(ps) }
    }
    return UrlSplit { scheme = scheme, host = host, port = port, path = path }
}
