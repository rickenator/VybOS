// vybos.vyb — VybOS framework core (M0).
//
// What a system IS, expressed as a Vyb program instead of a Nix file.
//
// NixOS build ideas borrowed here (we are a weird fork — "chopsticks"):
//   - derivations:     a value that fully describes how to build a thing from
//                      its inputs (Package = name + version + source identity).
//   - content-addressed store: an immutable store path derived from the
//                      package's identity. Nix hashes build *inputs*; M0 uses a
//                      stable FNV-1a stand-in on the package identity until a
//                      crypto digest lands in the stdlib.
//   - generations:     kept OUT of M0 on purpose, but the atomic-switchable
//                      profile is the shape this store is designed around.
//   - flake inputs:    later. A pinned, fixed source fetch; M0 just records the
//                      source string on each derivation.

import collections
import http
import io

// A derivation: everything needed to obtain/build one thing.
share(all)
struct Package {
    name<String>,
    version<String>,
    source<String>,       // where the inputs come from (url / git / local)
    storePath<String>     // content-addressed location in the immutable store
}

// A declarative service entry; enabled::Bool controls whether it activates.
share(all)
struct Service {
    name<String>,
    command<String>,
    enabled<Bool>
}

// The whole machine declaration, JIT-evaluated in one pass.
share(all)
struct SystemSpec {
    system<String>,            // target triple, e.g. "x86_64-linux"
    packages<Vec<Package>>,
    services<Vec<Service>>
}

// Stable, deterministic content hash over a package's declared identity string
// (FNV-1a accumulate + xor; a stand-in for a real digest). M0 used this for
// store paths; M1 moved to `content_hash(bytes, name, version)` which hashes
// the REAL fetched source bytes so the store path tracks actual inputs.
share(all)
name_hash(tag<String>)<Int> -> {
    h<Int> = 2166136261
    n<Int> = tag.len()
    for (i in 0..n) {
        c<Int> = tag.char_at(i)   // char_at yields an i8; widen to Int first
        h = (h * 16777619) ^ c
    }
    if (h < 0) {            // i64 wrap can go negative; store paths stay >= 0
        h = -h
    }
    return h
}

// Build a content-addressed store path:
//   /vyb/store/<hash>-<name>-<version>
share(all)
store_path(name<String>, version<String>)<String> -> {
    h<Int> = name_hash(name + "-" + version)
    return "/vyb/store/" + h.to_string() + "-" + name + "-" + version
}

// Composition helpers (the NixOS "build/compose" feel, in vybey).
share(all)
derive(name<String>, version<String>, source<String>)<Package> -> {
    return Package {
        name = name,
        version = version,
        source = source,
        storePath = store_path(name, version)
    }
}

share(all)
service(name<String>, command<String>)<Service> -> {
    return Service { name = name, command = command, enabled = true }
}

share(all)
new_spec(system<String>)<SystemSpec> -> {
    return SystemSpec {
        system = system,
        packages = Vec(),
        services = Vec()
    }
}

// === M1: realisation — real fetch → real content-address → store ===
//
// NixOS's key property is that a store path is a pure function of the *build
// inputs*. M0 faked it (hash of declared name/version); M1 hashes the REAL
// fetched source bytes plus identity, so a content change yields a new path.

// Content-address by actual source bytes + identity. Still a stand-in FNV-1a
// (no crypto hash in the stdlib yet — an RFE for the Vyb implementation
// agent), but now over the REAL inputs, which is what makes it a content
// address and buys dedup/caching.
share(all)
content_hash(bytes<String>, name<String>, version<String>)<Int> -> {
    tag<String> = name + ":" + version + ":" + bytes
    h1<Int> = 2166136261
    h2<Int> = 2246822519
    n<Int> = tag.len()
    for (i in 0..n) {
        c<Int> = tag.char_at(i)   // char_at is i8; widen before arithmetic
        h1 = (h1 * 16777619) ^ c
        h2 = (h2 * 2246822507) ^ c
    }
    h<Int> = h1 + h2 * 31
    if (h < 0) { h = -h }         // store paths stay non-negative
    return h
}

// Write bytes into the store. FLAT single-file layout for M1: the runtime has
// no mkdir *yet*, so storeDir must already exist and each derivation is one
// file `<hash>-<name>-<version>.src`. Returns success.
share(all)
materialize(bytes<String>, destPath<String>)<Bool> -> {
    match (open_write(destPath)) {
        w -> {
            n<Int> = write_str(w, bytes) else -1
            close(w)
            return n >= 0
        }
        ? -> { return false }
    }
}

// Fetch a real source over plain HTTP (full client), hash its actual bytes,
// materialize into the store dir, and return the filled Package whose
// storePath is the REAL content address. Absent on any failure → the build
// loop reports it rather than crashing.
//
// NOTE: plain HTTP/1.1 for now. HTTPS (TLS) + real tarball URLs with multi-
// segment paths are the next slice (see doc/STORE-LAYOUT.md).
share(all)
fetch_derivation(name<String>, version<String>, host<String>, port<Int>,
                 req_path<String>, source_url<String>, storeDir<String>)<Package?> -> {
    match (http_get_full(host, port, req_path)) {
        resp -> {
            if (resp.status != 200) {
                return Package?()
            }
            bytes<String> = resp.body
            h<Int> = content_hash(bytes, name, version)
            sp<String> = "/vyb/store/" + h.to_string() + "-" + name + "-" + version
            if (!materialize(bytes, storeDir + "/" + h.to_string() + "-" + name + "-" + version + ".src")) {
                return Package?()
            }
            return Package?(Package {
                name = name,
                version = version,
                source = source_url,
                storePath = sp
            })
        }
        ? -> { return Package?() }
    }
}
