// test_ed25519.vyb — smoke + correctness test for the new Ed25519 primitives
// (VybChain signature layer, issue #8 lead-in). Validates against the canonical
// RFC 8032 TEST 1 vector: seed 0x9d61...7f60, empty message, sig 0xe556...100b.
import crypto::{ed25519_publickey, ed25519_sign, ed25519_verify, sha256}

main()<Int> -> {
    seed = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    exp_pub = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    // RFC 8032 TEST 1 signature over the EMPTY message (hex).
    exp_sig = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155" +
              "5fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"

    ok1 = (ed25519_publickey(seed) == exp_pub)
    println("ED25519 PUB(VECTOR) " + if (ok1) { "OK" } else { "MISMATCH " + ed25519_publickey(seed) })

    sig = ed25519_sign(seed, "")
    ok2 = (sig == exp_sig)
    println("ED25519 SIG(VECTOR) " + if (ok2) { "OK" } else { "MISMATCH " + sig })

    // Round-trip over a real payload + negative cases.
    msg = "vybos boot receipt v1"
    s = ed25519_sign(seed, msg)
    good = ed25519_verify(exp_pub, msg, s)
    bad1 = ed25519_verify(exp_pub, msg + "X", s)          // tampered message
    bad2 = ed25519_verify(exp_pub, msg, s + "00")          // tampered sig (len 130 -> invalid)
    bad3 = ed25519_verify("00", msg, s)                    // wrong/truncated pub
    println("ED25519 RT(good)=" + good.to_string())
    println("ED25519 RT(tampered-msg)=" + (if (bad1) { "FAIL-should-be-false" } else { "OK-false" }))
    println("ED25519 RT(tampered-sig)=" + (if (bad2) { "FAIL-should-be-false" } else { "OK-false" }))
    println("ED25519 RT(wrong-pub)=" + (if (bad3) { "FAIL-should-be-false" } else { "OK-false" }))

    // Determinism: same seed+msg signs identically.
    d = (ed25519_sign(seed, msg) == ed25519_sign(seed, msg))
    println("ED25519 DETERMINISM " + if (d) { "OK" } else { "FAIL" })

    // Length sanity: pub 64 hex, sig 128 hex.
    println("ED25519 LEN pub=" + ed25519_publickey(seed).len().to_string() +
            " sig=" + ed25519_sign(seed, msg).len().to_string())

    ok_all = (ok1 && ok2 && good && !bad1 && !bad2 && !bad3 && d)
    println("ED25519: " + if (ok_all) { "PASS" } else { "FAIL" })
    return 0
}
