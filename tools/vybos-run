#!/usr/bin/env bash
# tools/vybos-run — VybOS rootfs launcher (issue #1 launcher shape).
#
# Boots the staged VybOS rootfs (default build/rootfs-out) to a defined
# VYBOS_READY state. A temp overlay copy is seeded with a static BusyBox
# userspace (host /usr/bin/busybox) so the rootfs is a self-contained /, and
# the config-driven /init runs to READY. The canonical rootfs is NEVER
# modified — writes happen only in the disposable overlay (tmp, rm'd on exit
# unless --keep).
# Runtimes:
#   bwrap  (default)  container-rootfs boot in a disposable bubblewrap sandbox (unprivileged)
#   docker            container-rootfs boot via docker import + run (needs docker daemon + group)
#   qemu              QEMU kernel+initramfs self-boot (Option A / B4): boots the rootfs as
#                     an initramfs under a real Linux kernel (Alpine netboot vmlinuz-virt, fetched
#                     to build/kernel-cache or --kernel), reaches READY on the serial console.
#
# Honest scope: bwrap/docker are CONTAINER-ROOTFS boots (B1 + B3-lite). qemu is
# a real kernel+initramfs boot (B4, Option A) — this is what closes the
# "bootable image" line. Userspace in all modes is a stand-in static BusyBox,
# seeded at launch, until VybOS ships its own.
#
# Usage:
#   tools/vybos-run [--rootfs <dir>] [--runtime bwrap|docker|qemu] [--kernel <path>] [--keep] [--test]
#     --test      boot and assert config paths exist + init reached READY -> exit 0/1
#     --runtime   bwrap (default, unprivileged) | docker | qemu (kernel+initramfs)
#     --kernel    explicit kernel bzImage for --runtime qemu (else cached Alpine vmlinuz-virt)
#     --rootfs    staged rootfs dir (default ../build/rootfs-out)
#     --keep      keep the disposable overlay on exit (debugging)
#     --busybox   path to a static busybox to seed (default /usr/bin/busybox)
#
set -uo pipefail

# repo root = parent of this script's dir
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOTFS="${VYBOS_ROOTFS:-$ROOT/build/rootfs-out}"
VYB="${VYB:-$HOME/Projects/Vyb-vybos/build/vyb}"
VYB_STDLIB="${VYB_STDLIB:-$HOME/Projects/Vyb-vybos/stdlib}"
BUSYBOX="${BUSYBOX:-/usr/bin/busybox}"
KERNEL="${VYBOS_KERNEL:-}"
# A DERIVED QEMU (build-derive-qemu.vyb) can be supplied explicitly so the boot
# proof never ASSUMES host qemu; falls back to qemu-system-x86_64 on PATH.
QEMU_BIN="${VYBOS_QEMU:-qemu-system-x86_64}"
QEMU_LIBDIR="${VYBOS_QEMU_LIBDIR:-}"
QEMU_DATA="${VYBOS_QEMU_DATA:-}"   # QEMU -L data dir (firmware/pc-bios); needed for a bare derived qemu
KERNEL_URL="https://dl-cdn.alpinelinux.org/alpine/v3.20/releases/x86_64/netboot/vmlinuz-virt"
MODE=run
RUNTIME="${VYBOS_RUNTIME:-bwrap}"
KEEP=0

while [ $# -gt 0 ]; do
  case "$1" in
    --test) MODE=test ;;
    --keep) KEEP=1 ;;
    --rootfs) ROOTFS="$2"; shift ;;
    --runtime) RUNTIME="$2"; shift ;;
    --kernel) KERNEL="$2"; shift ;;
    --qemu) QEMU_BIN="$2"; shift ;;
    --qemu-libdir) QEMU_LIBDIR="$2"; shift ;;
    --qemu-data) QEMU_DATA="$2"; shift ;;
    --busybox) BUSYBOX="$2"; shift ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

# 1. rootfs must be materialized (build it if absent).
if [ ! -d "$ROOTFS/etc/vyb-os" ]; then
  echo "rootfs not materialized; running build-rootfs.vyb..." >&2
  ( cd "$ROOT" && VYB_STDLIB="$VYB_STDLIB" "$VYB" build/build-rootfs.vyb --module-path modules ) >&2 || { echo "build-rootfs failed" >&2; exit 1; }
fi
if [ ! -f "$ROOTFS/init" ]; then
  echo "rootfs has no /init (rebuild with the current modules)" >&2; exit 1
fi

# 2. disposable overlay: copy rootfs, seed static busybox + RELATIVE applet links.
OVL=$(mktemp -d /tmp/vybos-run.XXXXXX)
cleanup() { [ "$KEEP" = 0 ] && rm -rf "$OVL"; }
trap cleanup EXIT
cp -a "$ROOTFS"/. "$OVL"/
mkdir -p "$OVL/bin"
cp "$BUSYBOX" "$OVL/bin/busybox"; chmod +x "$OVL/bin/busybox"
"$OVL/bin/busybox" --install -s "$OVL/bin" >/dev/null 2>&1 || true
# busybox --install makes ABSOLUTE symlinks (-> /tmp/.../busybox) that dangle
# once the overlay is the sandbox root; rewrite applet links to RELATIVE
# `busybox` so they resolve inside the booted root.
python3 - "$OVL/bin" <<'PY'
import os, sys
d = sys.argv[1]
for n in os.listdir(d):
    p = os.path.join(d, n)
    if os.path.islink(p) and n != "busybox":
        os.unlink(p); os.symlink("busybox", p)
PY

# 3. boot it.
case "$RUNTIME" in
  bwrap)
    OUT=$(bwrap --bind "$OVL" / --proc /proc --dev /dev --tmpfs /tmp \
          --die-with-parent --chdir / -- /bin/sh /init 2>&1)
    rc=$?
    ;;
  docker)
    # faithful container-rootfs: import the overlay as an ephemeral image, run /init.
    ( cd "$OVL" && tar -c . | docker import - vybos:rootfs >/dev/null 2>&1 )
    OUT=$(docker run --rm --read-only vybos:rootfs /bin/sh /init 2>&1)
    rc=$?
    ;;
  qemu)
    # kernel: explicit --kernel, else cached Alpine netboot vmlinuz-virt.
    if [ -z "$KERNEL" ]; then
      KC="$ROOT/build/kernel-cache"; KERNEL="$KC/vmlinuz-virt"
      if [ ! -s "$KERNEL" ]; then
        mkdir -p "$KC"
        echo "fetching kernel -> $KERNEL" >&2
        curl -sSL -o "$KERNEL" "$KERNEL_URL" || { echo "kernel fetch failed" >&2; exit 1; }
      fi
    fi
    if [ ! -s "$KERNEL" ]; then echo "no usable kernel at $KERNEL" >&2; exit 1; fi
    # kernel execve of /init needs the exec bit (staged 0644 -> EACCES otherwise).
    chmod +x "$OVL/init"
    IR=$(mktemp -d /tmp/vybos-run-qemu.XXXXXX)
    cp -a "$OVL"/. "$IR"/
    INITRD=$(mktemp /tmp/vybos-initrd.XXXXXX)
    ( cd "$IR" && find . -print0 | cpio --null -o --format=newc 2>/dev/null | gzip -1 ) > "$INITRD"
    SERIAL=$(mktemp /tmp/vybos-serial.XXXXXX)
    # use a DERIVED qemu if given; its glib lives in --qemu-libdir (LD_LIBRARY_PATH)
    # and its firmware in --qemu-data (QEMU -L).
    if [ -n "$QEMU_LIBDIR" ]; then export LD_LIBRARY_PATH="${QEMU_LIBDIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; fi
    QDATA=(); [ -n "$QEMU_DATA" ] && QDATA=(-L "$QEMU_DATA")
    "$QEMU_BIN" -m 256M -accel tcg -kernel "$KERNEL" -initrd "$INITRD" \
        -append "console=ttyS0 rdinit=/init" "${QDATA[@]}" -nographic -no-reboot > "$SERIAL" 2>&1 &
    QPID=$!
    # wait up to ~180s for the READY marker on serial (TCG is slow; no /dev/kvm).
    i=0; ready=0
    while [ $i -lt 360 ]; do
      grep -q 'VYBOS_READY=1' "$SERIAL" 2>/dev/null && { ready=1; break; }
      kill -0 "$QPID" 2>/dev/null || break
      sleep 0.5; i=$((i+1))
    done
    kill "$QPID" 2>/dev/null; wait "$QPID" 2>/dev/null
    rm -rf "$IR" "$INITRD"
    rc=0; [ "$ready" = 1 ] || rc=1
    OUT="$(cat "$SERIAL")"
    rm -f "$SERIAL"
    ;;
  *)
    echo "unknown --runtime: $RUNTIME" >&2; exit 2 ;;
esac
echo "$OUT"

# 4. validate: config paths present in the root + init reached READY.
paths_ok=1
for p in /etc/vyb-os/system.json /etc/vyb-os/version /etc/vyb-os/hostname /etc/vyb-os/services.sh /init; do
  if [ ! -e "$OVL$p" ]; then echo "MISSING (root): $p" >&2; paths_ok=0; fi
done
ready=0
echo "$OUT" | grep -q 'VYBOS_READY=1' && ready=1
echo ""

if [ "$MODE" = test ]; then
  if [ "$paths_ok" = 1 ] && [ "$ready" = 1 ] && [ "$rc" = 0 ]; then
    echo "VYBOS-RUN TEST PASS (ready, all config paths present)"
    exit 0
  fi
  echo "VYBOS-RUN TEST FAIL (paths_ok=$paths_ok ready=$ready rc=$rc)"
  exit 1
fi
exit "$rc"
