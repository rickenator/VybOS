#!/usr/bin/env bash
# tools/vybos-run — VybOS rootfs/QEMU launcher (issue #1 launcher shape).
#
# Boots a VybOS build artifact to a defined VYBOS_READY state. Two shapes:
#   (a) ROOTFS modes (bwrap/docker, and qemu as kernel+initramfs): stage the
#       materialized rootfs into a disposable overlay seeded with static
#       BusyBox; /init runs to READY. The canonical rootfs is NEVER modified.
#   (b) DISK mode (qemu, --disk <rootdisk.img>): boot a PERSISTENT raw ext4
#       root image as a real mounted root (root=/dev/vda) under the DERIVED
#       kernel — this is B5. The image already contains busybox + /init; state
#       persists across boots. No overlay, no initramfs.
# Runtimes:
#   bwrap  (default)  container-rootfs boot in a disposable bubblewrap sandbox (unprivileged)
#   docker            container-rootfs boot via docker import + run (needs docker daemon + group)
#   qemu  (+rootfs)   kernel+initramfs self-boot (B4): rootfs as initramfs under a kernel
#   qemu  (+--disk)   PERSISTENT root/disk self-boot (B5): raw ext4 root image mounted as /dev/vda
#
# Honest scope: bwrap/docker are CONTAINER-ROOTFS boots (B1 + B3-lite). qemu
# closes the "bootable image" line. Userspace in all modes is a stand-in static
# BusyBox until VybOS ships its own. A bootloader, atomic gen-switch, and guest
# SSH/virtiofs are still ahead — --ssh-port/--share-vyb are recognized and
# rejected clearly.
#
# Usage:
#   tools/vybos-run [OPTIONS]
#     --runtime <bwrap|docker|qemu>   default bwrap
#     --test      boot and assert config paths exist + init reached READY -> exit 0/1
#     --keep      keep the disposable overlay (and any serial log) on exit (debugging)
#
#   Rootfs/container options (all runtimes):
#     --rootfs <dir>    staged rootfs dir (default ../build/rootfs-out)
#     --busybox <path>  static busybox to seed (default /usr/bin/busybox)
#
#   QEMU options (--runtime qemu):
#     --disk <img>           boot a PERSISTENT raw ext4 root image (B5); requires the
#                            DERIVED kernel (ext4+virtio built-in). Auto-found in store/.
#     --kernel <bzImage>     explicit kernel bzImage (for --disk use the derived one)
#     --memory <size>        guest RAM for -m (default 256M)
#     --cpus <n>             vCPUs for -smp (default 1)
#     --headless             serial-only, -nographic (DEFAULT)
#     --gui                  open a display instead of -nographic
#     --no-kvm               force TCG (default: use KVM when /dev/kvm is writable, else TCG)
#     --gdb                  start QEMU paused under gdb (tcp::1234, -S)
#     --log <path>           write the serial log here (default: .logs/qemu/vybos-<ts>.log)
#     --qemu <bin>           qemu binary (default qemu-system-x86_64; or store/<qca>/qemu-system-x86_64)
#     --qemu-libdir <dir>    # LD_LIBRARY_PATH for a bare derived qemu (its glib)
#     --qemu-data <dir>      # QEMU -L data dir (pc-bios firmware) for a bare derived qemu
#
#   Pending (rejected with a clear message today; see doc/PLAN-QEMU-LAUNCHER.md):
#     --ssh-port <port>      # needs VybOS to actually run SSH
#     --share-vyb <dir>      # guest virtiofs/9p — needs a disk-image based boot + guest drivers
#
set -uo pipefail

# repo root = parent of this script's dir
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOTFS="${VYBOS_ROOTFS:-$ROOT/build/rootfs-out}"
VYB="${VYB:-$HOME/Projects/Vyb-vybos/build/vyb}"
VYB_STDLIB="${VYB_STDLIB:-$HOME/Projects/Vyb-vybos/stdlib}"
BUSYBOX="${BUSYBOX:-/usr/bin/busybox}"
KERNEL="${VYBOS_KERNEL:-}"
DISK="${VYBOS_DISK:-}"
# A DERIVED QEMU (build-derive-qemu.vyb) can be supplied explicitly so the boot
# proof never ASSUMES host qemu; falls back to qemu-system-x86_64 on PATH.
QEMU_BIN="${VYBOS_QEMU:-qemu-system-x86_64}"
QEMU_LIBDIR="${VYBOS_QEMU_LIBDIR:-}"
QEMU_DATA="${VYBOS_QEMU_DATA:-}"   # QEMU -L data dir (firmware/pc-bios); needed for a bare derived qemu
MEMORY="${VYBOS_MEMORY:-256M}"
CPUS="${VYBOS_CPUS:-1}"
HEADLESS=1
NO_KVM=0
GDB=0
LOGFILE="${VYBOS_LOG:-}"
KERNEL_URL="https://dl-cdn.alpinelinux.org/alpine/v3.20/releases/x86_64/netboot/vmlinuz-virt"
MODE=run
RUNTIME="${VYBOS_RUNTIME:-bwrap}"
KEEP=0

while [ $# -gt 0 ]; do
  case "$1" in
    --test) MODE=test ;;
    --keep) KEEP=1 ;;
    --rootfs) ROOTFS="$2"; shift ;;
    --runtime) RUNTIME="$2"; shift ;;
    --disk) DISK="$2"; shift ;;
    --kernel) KERNEL="$2"; shift ;;
    --memory) MEMORY="$2"; shift ;;
    --cpus) CPUS="$2"; shift ;;
    --headless) HEADLESS=1 ;;
    --gui) HEADLESS=0 ;;
    --no-kvm) NO_KVM=1 ;;
    --gdb) GDB=1 ;;
    --log) LOGFILE="$2"; shift ;;
    --qemu) QEMU_BIN="$2"; shift ;;
    --qemu-libdir) QEMU_LIBDIR="$2"; shift ;;
    --qemu-data) QEMU_DATA="$2"; shift ;;
    --busybox) BUSYBOX="$2"; shift ;;
    --ssh-port) echo "error: --ssh-port needs VybOS to actually run SSH in-guest — not yet" >&2; exit 2 ;;
    --share-vyb) echo "error: --share-vyb needs a disk-image based boot + guest virtiofs/9p drivers — pending" >&2; exit 2 ;;
    -h|--help) grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

if [ -n "$DISK" ] && [ "$RUNTIME" != qemu ]; then
  echo "error: --disk <img> requires --runtime qemu (bwrap/docker boot the rootfs overlay, not a disk image)" >&2
  exit 2
fi
# normalize --disk to an absolute path (qemu-img resolves the backing file
# relative to the overlay dir in /tmp, so a relative store/... base breaks it).
if [ -n "$DISK" ] && [ "${DISK#/}" = "$DISK" ]; then DISK="$PWD/$DISK"; fi

# kernel resolution for qemu: --kernel wins; a --disk boot requires the DERIVED
# kernel (ext4 + virtio-blk built-in — the Alpine netboot vmlinuz can't mount a
# disk root); otherwise the cached Alpine netboot vmlinuz (initramfs boot).
resolve_kernel() {
  if [ -n "$KERNEL" ]; then echo "$KERNEL"; return; fi
  if [ -n "$DISK" ]; then
    local k; k="$(find "$ROOT/store" -name 'linux-6.6-bzImage.bin' 2>/dev/null | head -1)"
    if [ -z "$k" ]; then
      echo "error: --disk needs the DERIVED kernel (ext4+virtio=y); none in store/. Build it (build/build-derive-kernel.vyb) or pass --kernel <bzImage>." >&2
      exit 1
    fi
    echo "$k"
  else
    local k="$ROOT/build/kernel-cache/vmlinuz-virt"
    if [ ! -s "$k" ]; then
      mkdir -p "$ROOT/build/kernel-cache"
      echo "fetching kernel -> $k" >&2
      curl -sSL -o "$k" "$KERNEL_URL" || { echo "kernel fetch failed" >&2; exit 1; }
    fi
    echo "$k"
  fi
}

# 1. rootfs must be materialized — only needed for the OVERLAY (rootfs) modes,
#    not for a --disk boot (the disk image is already self-contained).
OVL=""
if [ -z "$DISK" ]; then
  if [ ! -d "$ROOTFS/etc/vyb-os" ]; then
    echo "rootfs not materialized; running build-rootfs.vyb..." >&2
    ( cd "$ROOT" && VYB_STDLIB="$VYB_STDLIB" "$VYB" build/build-rootfs.vyb --module-path modules ) >&2 || { echo "build-rootfs failed" >&2; exit 1; }
  fi
  if [ ! -f "$ROOTFS/init" ]; then
    echo "rootfs has no /init (rebuild with the current modules)" >&2; exit 1
  fi

  # 2. disposable overlay: copy rootfs, seed static busybox + RELATIVE applet links.
  OVL=$(mktemp -d /tmp/vybos-run.XXXXXX)
  cp -a "$ROOTFS"/. "$OVL"/
  mkdir -p "$OVL/bin"
  cp "$BUSYBOX" "$OVL/bin/busybox"; chmod +x "$OVL/bin/busybox"
  "$OVL/bin/busybox" --install -s "$OVL/bin" >/dev/null 2>&1 || true
  # busybox --install makes ABSOLUTE symlinks (-> /tmp/.../busybox) that dangle
  # once the overlay is the sandbox root; rewrite applet links to RELATIVE
  # `busybox` so they resolve inside the booted root.
  python3 - "$OVL/bin" <<'PY'
import os, sys
d = sys.argv[1]
for n in os.listdir(d):
    p = os.path.join(d, n)
    if os.path.islink(p) and n != "busybox":
        os.unlink(p); os.symlink("busybox", p)
PY
fi
OVL=${OVL:-}    # rootfs overlay (bwrap/docker/rootfs-qemu)
QOVER=${QOVER:-} # disposable writable QCOW2 overlay over the --disk base image
trap 'cleanup' EXIT
cleanup() { if [ "$KEEP" = 0 ]; then [ -n "$OVL" ] && rm -rf "$OVL"; [ -n "$QOVER" ] && rm -f "$QOVER"; fi; }

# 3. boot it.
case "$RUNTIME" in
  bwrap)
    OUT=$(bwrap --bind "$OVL" / --proc /proc --dev /dev --tmpfs /tmp \
          --die-with-parent --chdir / -- /bin/sh /init 2>&1)
    rc=$?
    ;;
  docker)
    ( cd "$OVL" && tar -c . | docker import - vybos:rootfs >/dev/null 2>&1 )
    OUT=$(docker run --rm --read-only vybos:rootfs /bin/sh /init 2>&1)
    rc=$?
    ;;
  qemu)
    KERNEL="$(resolve_kernel)"
    [ -s "$KERNEL" ] || { echo "no usable kernel at $KERNEL" >&2; exit 1; }

    # use a DERIVED qemu if given; its glib lives in --qemu-libdir (LD_LIBRARY_PATH)
    # and its firmware in --qemu-data (QEMU -L).
    if [ -n "$QEMU_LIBDIR" ]; then export LD_LIBRARY_PATH="${QEMU_LIBDIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; fi
    QDATA=(); [ -n "$QEMU_DATA" ] && QDATA=(-L "$QEMU_DATA")

    # accel: KVM when writable, else TCG (this host has no /dev/kvm); --no-kvm forces TCG.
    ACCEL=tcg
    if [ "$NO_KVM" = 0 ] && [ -w /dev/kvm ]; then ACCEL=kvm; fi
    [ "$NO_KVM" = 1 ] && ACCEL=tcg

    # persistent serial log (issue #1 log convention): default under .logs/qemu/.
    if [ -z "$LOGFILE" ]; then
      LOGDIR="$ROOT/.logs/qemu"; LOGSTAMP=$(date +%Y%m%d-%H%M%S)
      LOGFILE="$LOGDIR/vybos-$LOGSTAMP.log"
    fi
    mkdir -p "$(dirname "$LOGFILE")"

    if [ -n "$DISK" ]; then
      # ---- DISK boot (B5): persistent root image mounted as /dev/vda ----
      if [ ! -s "$DISK" ]; then echo "no usable disk image at $DISK" >&2; exit 1; fi
      # Disposable writable QCOW2 overlay (issue #1 immutability, §4.1): the
      # canonical store image is NEVER modified; writes go to a temp overlay
      # (rm'd on exit unless --keep). Fall back to direct raw if qemu-img absent.
      QOVER=$(mktemp /tmp/vybos-overlay.XXXXXX.qcow2)
      if qemu-img create -f qcow2 -b "$DISK" -F raw "$QOVER" >/dev/null 2>&1; then
        DRIVE="file=$QOVER,format=qcow2,if=virtio"
      else
        rm -f "$QOVER"; QOVER=""; DRIVE="file=$DISK,format=raw,if=virtio"
      fi
      echo "runtime=qemu disk=$DISK overlay=$([ -n "$QOVER" ] && echo "$QOVER" || echo "direct(no qemu-img)") kernel=$KERNEL memory=$MEMORY cpus=$CPUS accel=$ACCEL qemu=$QEMU_BIN" >&2
      echo "serial log -> $LOGFILE" >&2
      QARGS=(-m "$MEMORY" -smp "$CPUS" -accel "$ACCEL" -kernel "$KERNEL" -drive "$DRIVE")
      [ "$GDB" = 1 ] && QARGS+=(-gdb tcp::1234 -S)
      if [ "$HEADLESS" = 1 ]; then QARGS+=(-append "root=/dev/vda rw init=/init console=ttyS0" -nographic -no-reboot)
      else QARGS+=(-append "root=/dev/vda rw init=/init console=ttyS0" -no-reboot); fi
      [ ${#QDATA[@]} -gt 0 ] && QARGS+=("${QDATA[@]}")
      "$QEMU_BIN" "${QARGS[@]}" > "$LOGFILE" 2>&1 &
      QPID=$!
      i=0; ready=0
      while [ $i -lt 360 ]; do
        grep -q 'VYBOS_READY=1' "$LOGFILE" 2>/dev/null && { ready=1; break; }
        kill -0 "$QPID" 2>/dev/null || break
        sleep 0.5; i=$((i+1))
      done
      kill "$QPID" 2>/dev/null
      wait "$QPID" 2>/dev/null
      rc=0; [ "$ready" = 1 ] || rc=1
      OUT="$(cat "$LOGFILE")"
    else
      # ---- kernel+initramfs boot of the staged rootfs ----
      chmod +x "$OVL/init"
      IR=$(mktemp -d /tmp/vybos-run-qemu.XXXXXX)
      cp -a "$OVL"/. "$IR"/
      INITRD=$(mktemp /tmp/vybos-initrd.XXXXXX)
      ( cd "$IR" && find . -print0 | cpio --null -o --format=newc 2>/dev/null | gzip -1 ) > "$INITRD"
      echo "runtime=qemu rootfs-initramfs kernel=$KERNEL memory=$MEMORY cpus=$CPUS accel=$ACCEL qemu=$QEMU_BIN" >&2
      echo "serial log -> $LOGFILE" >&2
      QARGS=(-m "$MEMORY" -smp "$CPUS" -accel "$ACCEL" -kernel "$KERNEL" -initrd "$INITRD")
      [ "$GDB" = 1 ] && QARGS+=(-gdb tcp::1234 -S)
      if [ "$HEADLESS" = 1 ]; then QARGS+=(-append "console=ttyS0 rdinit=/init" -nographic -no-reboot)
      else QARGS+=(-append "console=ttyS0 rdinit=/init" -no-reboot); fi
      [ ${#QDATA[@]} -gt 0 ] && QARGS+=("${QDATA[@]}")
      "$QEMU_BIN" "${QARGS[@]}" > "$LOGFILE" 2>&1 &
      QPID=$!
      i=0; ready=0
      while [ $i -lt 360 ]; do
        grep -q 'VYBOS_READY=1' "$LOGFILE" 2>/dev/null && { ready=1; break; }
        kill -0 "$QPID" 2>/dev/null || break
        sleep 0.5; i=$((i+1))
      done
      kill "$QPID" 2>/dev/null
      wait "$QPID" 2>/dev/null
      rm -rf "$IR" "$INITRD"
      rc=0; [ "$ready" = 1 ] || rc=1
      OUT="$(cat "$LOGFILE")"
    fi
    ;;
  *)
    echo "unknown --runtime: $RUNTIME" >&2; exit 2 ;;
esac
echo "$OUT"

# 4. validate config paths present for overlay modes; a --disk boot is self-contained.
paths_ok=1
if [ -n "$OVL" ]; then
  for p in /etc/vyb-os/system.json /etc/vyb-os/version /etc/vyb-os/hostname /etc/vyb-os/services.sh /init; do
    if [ ! -e "$OVL$p" ]; then echo "MISSING (root): $p" >&2; paths_ok=0; fi
  done
fi
ready=0
echo "$OUT" | grep -q 'VYBOS_READY=1' && ready=1
echo ""

if [ "$MODE" = test ]; then
  if [ "$paths_ok" = 1 ] && [ "$ready" = 1 ] && [ "$rc" = 0 ]; then
    echo "VYBOS-RUN TEST PASS (ready, all config paths present)"
    [ "$KEEP" = 1 ] && [ "$RUNTIME" = qemu ] && echo "serial log kept: $LOGFILE"
    [ "$KEEP" = 1 ] && [ -n "$QOVER" ] && echo "overlay kept: $QOVER (base image immutable)"
    exit 0
  fi
  echo "VYBOS-RUN TEST FAIL (paths_ok=$paths_ok ready=$ready rc=$rc)"
  [ "$RUNTIME" = qemu ] && [ -n "$LOGFILE" ] && echo "serial log: $LOGFILE"
  exit 1
fi
exit "$rc"
